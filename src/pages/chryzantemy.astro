---
import BaseLayout from "../layouts/BaseLayout.astro";
import OfferSection from "../components/OfferSection.astro";
import { chrysanthemumStrip } from "../data/gallery";

/** `/chryzantemy/` - the WordPress address, unchanged (docs/przekierowania.md).
 *
 *  The dates in `note` are the ones from the autumn season card, kept in one wording so
 *  the two cannot say different things. */
---

<BaseLayout
  title="Chryzantemy wielkokwiatowe"
  description="Chryzantemy wielkokwiatowe, średniokwiatowe, drobnokwiatowe i igiełkowe z własnej uprawy. Sprzedaż od początku października do 1 listopada, duży wybór kolorów. Gospodarstwo Ogrodnicze „Saran” pod Kazimierzem Dolnym."
  canonical="/chryzantemy/"
  breadcrumb="Chryzantemy"
>
  <OfferSection
    group="Chryzantemy"
    title="Chryzantemy"
    note="W uprawie znajdują się chryzantemy wielkokwiatowe, średniokwiatowe, drobnokwiatowe i igiełkowe. Przed Wszystkimi Świętymi zamówienia najlepiej złożyć z tygodniowym wyprzedzeniem."
    photos={chrysanthemumStrip}
  />
</BaseLayout>
