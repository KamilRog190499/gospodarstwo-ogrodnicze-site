---
import BaseLayout from "../layouts/BaseLayout.astro";
import { navigation } from "../data/navigation";
import { primaryPhone } from "../data/contact";

/**
 * Served at every address that does not exist, which is why it is `noindex` and carries no
 * canonical of its own.
 *
 * It matters more here than on most sites: the WordPress install had five addresses that
 * people and search engines still hold, and until the redirects in docs/przekierowania.md
 * are in place on the server this page is where some of them land - so it now lists where
 * they were most likely trying to go, rather than only offering the home page.
 *
 * The title is an `h1`. It was an `h2`, because the masthead held the page's only `h1`.
 */

/** The menu minus the home page: it is already the button above this list, and one address
 *  offered twice on the same screen reads as two different destinations. */
const otherPages = navigation.filter((item) => item.href !== "/");
---

<BaseLayout
  title="Nie ma takiej strony"
  description="Pod tym adresem nic nie ma. Wróć na stronę główną albo zadzwoń - zamówienia przyjmujemy telefonicznie."
  canonical="/404/"
  noindex
>
  <section class="missing">
    <h1 class="missing__title">Nie ma takiej strony</h1>
    <p class="missing__body">
      Pod tym adresem nic nie ma. Być może strona się przeniosła albo adres jest niepełny.
    </p>
    <div class="missing__actions">
      <a class="cta" href="/">Strona główna</a>
      <a class="cta-line" href={primaryPhone.href}>Zadzwoń: {primaryPhone.display}</a>
    </div>

    <nav class="missing__nav" aria-labelledby="missing-nav-title">
      <h2 class="missing__navTitle" id="missing-nav-title">Strony na tej witrynie</h2>
      <ul>
        {
          otherPages.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .missing {
    padding: var(--pad-section-wide) var(--edge);
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    text-align: center;
  }

  .missing__title {
    font-size: var(--text-h2-wide);
  }

  .missing__body {
    max-width: 46ch;
    color: var(--ink-soft);
  }

  .missing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    justify-content: center;
  }

  .missing__nav {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    width: min(100%, 46rem);
  }

  .missing__navTitle {
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }

  .missing__nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 2rem;
  }

  .missing__nav a {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-link);
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .missing__nav a:hover {
    color: var(--green);
    border-bottom-color: var(--green);
  }
</style>
