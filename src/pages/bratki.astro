---
import BaseLayout from "../layouts/BaseLayout.astro";
import OfferSection from "../components/OfferSection.astro";
import { pansyPhoto, pansyStrip } from "../data/gallery";
import { windowFor } from "../data/season";

/** `/bratki/` - the one offer address with no WordPress predecessor: the old site did not
 *  sell pansies anywhere on it (docs/przekierowania.md, docs/inwentaryzacja.md).
 *
 *  **No date is written into this page any more.** The selling window is printed by
 *  `OfferSection` from `src/data/season.ts`, which is the point: the sentences here used to
 *  say "sprzedaż w marcu i kwietniu" and "zanim ruszą kwiaty balkonowe i rabatowe", and both
 *  became untrue in September 2026 when the owners cut the pansy window back to March alone
 *  and moved the balcony flowers up to April. Nothing here noticed, because the dates were
 *  typed in by hand.
 *
 *  **Primroses have their own entry since September 2026.** They were a word on this page for
 *  as long as nothing existed to make an entry out of; the owners then supplied a photograph
 *  and a description, and `prymulka.md` closed that open item. They share the pansies' selling
 *  window - "mostly March, sometimes the start of April" in the owners' own words - so nothing
 *  changed in `src/data/season.ts` and the entry carries the same `Sprzedaż` fact its
 *  group-mate does.
 *
 *  The `h1` moved with it: "Bratki i prymulki", which is what `navigation.ts` and the home
 *  page tile have called this page all along. The canonical stays "/bratki/"; the breadcrumb
 *  followed the menu label in October 2026, when every breadcrumb was aligned with the menu.
 *
 *  **The `<title>` carries both words.** "Bratki" is the word the page has to rank on and still
 *  leads; "Bratki i prymulki | Gospodarstwo Ogrodnicze „Saran”" is 54 characters against a
 *  budget of 60, so the second word costs nothing the first one needed. In March "prymulki" is
 *  its own query and this page is the only answer the site has to it.
 *
 *  The `description` names the month from `season.ts` too - it said "w marcu" by hand until
 *  October 2026, the one date left on this page that the paragraph above says is gone. */
const saleWindow = windowFor("Bratki");
const selling = saleWindow ? ` Sprzedaż: ${saleWindow.months.toLocaleLowerCase("pl-PL")}.` : "";
---

<BaseLayout
  title="Bratki i prymulki"
  description={`Bratki i prymulki z własnej uprawy, duży wybór kolorów. Gospodarstwo Ogrodnicze „Saran” pod Kazimierzem Dolnym.${selling}`}
  ogImage={pansyPhoto.src}
  ogImageAlt={pansyPhoto.alt}
  canonical="/bratki/"
  breadcrumb="Bratki i prymulki"
>
  <OfferSection
    group="Bratki"
    title="Bratki i prymulki"
    note="Bratkami i prymulkami otwieramy sezon - są w sprzedaży najwcześniej ze wszystkiego, co uprawiamy, zanim ruszą kwiaty balkonowe i rabatowe."
    photos={pansyStrip}
  />
</BaseLayout>
