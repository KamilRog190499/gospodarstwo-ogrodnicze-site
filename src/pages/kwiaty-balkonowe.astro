---
import BaseLayout from "../layouts/BaseLayout.astro";
import OfferSection from "../components/OfferSection.astro";
import { balconyStrip } from "../data/gallery";

/**
 * `/kwiaty-balkonowe/` - the WordPress address, unchanged, so no 301 is needed and the
 * page that ranks for "kwiaty balkonowe Kazimierz Dolny" keeps ranking
 * (docs/przekierowania.md).
 *
 * Since September 2026 it is also where `/rabatowe/` went: the owners had the two groups
 * merged, so this page carries all 34 of them and `/rabatowe/` is a 301 onto it. The
 * argument is in `src/data/offer.ts`.
 *
 * **The description is where "rabatowe i wieloletnie" survives.** The owners chose "Kwiaty
 * balkonowe" as the name of the merged page, which drops a phrase the old site ranked on
 * from the title and the menu; keeping it here costs the page nothing and keeps the words
 * people actually search for in the one field written for them. Both halves of the old
 * descriptions are folded in.
 *
 * **The alphabet started here and is no longer this page's alone.** 34 entries in editorial
 * `order` is a list nobody can find anything in, which is what first put this page in Polish
 * alphabetical order with the letter index and the dividers; `/bratki/` and `/chryzantemy/`
 * stayed in `order` on the argument that a short page has no use for a finding aid. The owners
 * looked at both and had the three pages aligned, so `OfferSection` runs one shape for all of
 * them and there is no `sort` prop to pass any more. Nothing on this page changed.
 *
 * **The photo strip arrived last**, in September 2026, and with it the last difference in
 * layout between the three category pages. The hold-up was never the code - `OfferSection`
 * has taken `photos` all along - but the material: the 23 frames in `src/assets/gallery/`
 * belong to `/inspiracje/`, and eighteen of this group's own entries were standing on
 * borrowed photographs. `balconyStrip` is argued out in `src/data/gallery.ts`, including why
 * nine mixed plantings from the same batch stayed off it.
 */
---

<BaseLayout
  title="Kwiaty balkonowe"
  description="Kwiaty balkonowe, rabatowe i wieloletnie z własnej uprawy pod Kazimierzem Dolnym: pelargonie, petunie i surfinie, begonie, fuksje, hortensje. 34 rośliny."
  canonical="/kwiaty-balkonowe/"
  breadcrumb="Kwiaty balkonowe"
>
  <OfferSection
    group="Balkonowe"
    title="Kwiaty balkonowe"
    note="Poza samymi roślinami sprzedajemy gotowe obsadzone skrzynki, kosze i doniczki - kompozycje można oglądać w zakładce Inspiracje."
    photos={balconyStrip}
  />
</BaseLayout>
