---
import BaseLayout from "../layouts/BaseLayout.astro";
import Compositions from "../components/Compositions.astro";

/**
 * `/inspiracje/` - the plantings, and the one page on the site whose visitor has already
 * decided they like something. It used to be a dead end: 23 photographs, one address, no
 * links out. Every panel now names its plants and offers the phone.
 */
---

<BaseLayout
  title="Inspiracje - obsadzone kosze, skrzynki i donice"
  description="Obsadzenia z kwiatów z naszej uprawy - kosze wiszące, skrzynki, donice i rabaty. Przy każdym piszemy, jakie kwiaty w nim są i gdzie ich szukać w ofercie. Gospodarstwo Ogrodnicze „Saran” w Cholewiance pod Kazimierzem Dolnym."
  canonical="/inspiracje/"
  breadcrumb="Inspiracje"
>
  <Compositions />
</BaseLayout>
