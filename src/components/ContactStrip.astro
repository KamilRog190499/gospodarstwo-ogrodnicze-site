---
import { addressOneLine, directionsUrl, primaryPhone } from "../data/contact";

/**
 * Pasek „gdzie i pod jaki numer”, nad stopką strony głównej.
 *
 * Powód: adres padał dotąd wyłącznie w prozie Intro i w stopce, a gospodarstwo sprzedaje
 * na miejscu i nie prowadzi sklepu — „gdzie to jest i jak zadzwonić” jest pierwszym
 * pytaniem odwiedzającego, nie ostatnim. Cała treść pochodzi z contact.ts; ten komponent
 * niczego nie definiuje, tylko wystawia to wcześniej.
 *
 * Godzin sprzedaży tu nie ma, bo nikt ich nam nie podał. Kiedy właściciele je podadzą,
 * dochodzi trzecia kolumna i nic poza tym.
 */
---

<aside class="strip" aria-label="Adres i telefon">
  <div class="strip__item">
    <p class="eyebrow strip__label">Gdzie</p>
    <p class="strip__value">{addressOneLine}</p>
  </div>
  <div class="strip__item">
    <p class="eyebrow strip__label">Telefon</p>
    <p class="strip__value">
      <a class="strip__tel" href={primaryPhone.href}>{primaryPhone.display}</a>
    </p>
  </div>
  <a class="cta-line strip__route" href={directionsUrl} target="_blank" rel="noopener">
    Wyznacz trasę
  </a>
</aside>

<style>
  .strip {
    border-top: 1px solid var(--rule);
    background: var(--paper-dim);
    padding: clamp(1.25rem, 3vw, 1.75rem) var(--edge);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem clamp(1.5rem, 5vw, 2.5rem);
  }

  .strip__label {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
  }

  .strip__value {
    font-family: var(--serif);
    font-size: var(--text-tel);
    line-height: 1.3;
  }

  .strip__tel {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule-link);
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .strip__tel:hover {
    color: var(--green);
    border-bottom-color: var(--green);
  }

  /* Na szerokim ekranie odpycha się do prawej krawędzi; po zawinięciu siada pod adresem
     bez marginesu, bo `auto` na wrapniętym elemencie flex nic nie robi. */
  .strip__route {
    margin-inline-start: auto;
  }
</style>
