---
import { navigation } from "../data/navigation";

/**
 * Pasek menu.
 *
 * Nie zwija się. Siedem pozycji zawija się na drugą linię na wąskim ekranie, i to znaczy,
 * że witryna nie wysyła ani linijki JavaScriptu do menu — nie ma tu nic, co może się nie
 * otworzyć.
 *
 * Motyw 2a nie zmienia tego pliku: pasek zachowuje delikatne tło `--paper-dim`, kreskę
 * nad sobą i własny `padding-inline`. Warunek jest po stronie `Header.astro` — `<Nav />`
 * musi stać poza paddingiem nazwy, jako osobny wiersz gridu nagłówka, inaczej marginesy
 * boczne dodają się podwójnie i pasek rozjeżdża się względem nazwy.
 *
 * `aria-current="page"` plus zielone podkreślenie na bieżącej pozycji — bez zmian.
 * `trailingSlash: "always"` w astro.config.mjs oznacza, że obie strony porównania mają
 * ukośnik, więc nic nie trzeba normalizować.
 */
const path = Astro.url.pathname;
---

<nav aria-label="Główne">
  <ul>
    {
      navigation.map((item) => (
        <li>
          <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav {
    border-top: 1px solid var(--rule);
    background: var(--paper-dim);
  }

  ul {
    padding-inline: var(--edge-nav);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    /* Row gap zero: cele dotykowe 48px same rozdzielają zawinięte rzędy. */
    gap: 0 clamp(1rem, 3vw, 2.5rem);
  }

  a {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--green-deep);
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    /* Przezroczysta, nie brak — żeby hover nie przesuwał tekstu o 2px. */
    border-bottom: 2px solid transparent;
  }

  a:hover {
    color: var(--ink);
    border-bottom-color: var(--green);
  }

  a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--green);
  }
</style>
