---
import { navigation } from "../data/navigation";

/**
 * The menu bar.
 *
 * It does not collapse. Eight items wrap onto a second line on a narrow screen, and that
 * means the site sends not one line of JavaScript for the menu - there is nothing here that
 * can fail to open.
 *
 * The 2a theme does not change this file: the bar keeps its faint `--paper-dim` ground, the
 * rule above it and its own `padding-inline`. The condition sits in `Header.astro` -
 * `<Nav />` has to stand outside the name's padding, as a separate row of the header grid,
 * or the side margins are added twice and the bar drifts out of line with the name.
 *
 * `aria-current="page"` plus the green underline on the current item - unchanged.
 * `trailingSlash: "always"` in astro.config.mjs means both sides of the comparison carry a
 * slash, so there is nothing to normalise.
 */
const path = Astro.url.pathname;
---

<nav aria-label="Główne">
  <ul>
    {
      navigation.map((item) => (
        <li>
          <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav {
    border-top: 1px solid var(--rule);
    background: var(--paper-dim);
  }

  ul {
    padding-inline: var(--edge-nav);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    /* Row gap of zero: the 48px touch targets separate the wrapped rows by themselves. */
    gap: 0 clamp(1rem, 3vw, 2.5rem);
  }

  a {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--green-deep);
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    /* Transparent rather than absent - so hover does not shift the text by 2px. */
    border-bottom: 2px solid transparent;
  }

  a:hover {
    color: var(--ink);
    border-bottom-color: var(--green);
  }

  a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--green);
  }
</style>
