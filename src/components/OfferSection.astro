---
import { getCollection } from "astro:content";
import PlantEntry from "./PlantEntry.astro";
import PhotoStrip from "./PhotoStrip.astro";
import { offerPages } from "../data/navigation";
import { plantCount, type PlantGroup } from "../data/offer";
import { currentSeason, windowFor } from "../data/season";
import type { GalleryPhoto } from "../data/gallery";
import { primaryPhone } from "../data/contact";

/**
 * The body of one category page: `/kwiaty-balkonowe/`, `/bratki/`, `/chryzantemy/`.
 *
 * One component rather than three copies of the same markup - docs/przekierowania.md said
 * as much: "ta sama sekcja, węższy zbiór wpisów, ten sam komponent PlantEntry, ta sama
 * siatka". Each page passes its group and its own words; everything else is here.
 *
 * ## One shape, whether the page is long or short
 *
 * `/bratki/` holds two entries, `/chryzantemy/` three and `/kwiaty-balkonowe/` thirty-four,
 * the last having absorbed `Rabatowe` in September 2026 (see `src/data/offer.ts`). All three
 * run the same way: Polish alphabetical order, an index grouped by initial, and a letter
 * between the entries as the page scrolls past.
 *
 * **That is the owners' call, and it reverses what stood here.** This component took a
 * `sort: "order" | "name"` prop until they saw both shapes side by side - the long page
 * alphabetical with its finding aids, the two short ones in editorial `order` on a flat list.
 * The argument for the split was that two or three plants need no finding aid, and that `order`
 * is where the owners say what they consider most important. They asked for the three pages to
 * be aligned with no exceptions, so the prop went with the argument it existed for.
 *
 * **The price is on `/chryzantemy/`, and it was accepted knowingly.** Alphabetical order
 * reverses that page, so chryzantema wielkokwiatowa - the flagship, and the word in the page's
 * own `<title>` - now stands last, and the entry that leads is the one whose description is
 * ours rather than the owners'. All three names share an initial, so the divider above the
 * first entry parts nothing from nothing and the index has a single row. The page draws them
 * anyway: "no exceptions" is what was asked for, and a rule with a length threshold in it is
 * the thing that was removed.
 *
 * Outline: `h1` (this page's subject) then one `h2` per plant. No level is skipped and no
 * heading names anything other than the thing under it.
 *
 * The two blocks after the list exist because a category page is now an entry point -
 * people arrive on it straight from search, having never seen the home page. Without them
 * the page ends with the last plant and nothing to do next.
 *
 * That is also why the selling window is printed here from 0.9 on, under the heading: the
 * home page says whether a group is on sale on its season cards, and someone who arrives
 * from a search for "chryzantemy Kazimierz Dolny" never sees them. The line is built from `saleWindows`, so the
 * dates on this page cannot drift from the dates the tiles and the season cards quote - and
 * they had drifted. `/bratki/` was still offering "sprzedaż w marcu i kwietniu" after the
 * owners cut the window back to March, because that sentence was typed into the page by hand.
 */
interface Props {
  /** The `group` value in the plants' frontmatter. */
  group: PlantGroup;
  title: string;
  /** Sentence beside the heading. Defaults to `OFFER_LEAD` below, which is what every
   *  category page wants; pass a different one only for a page that genuinely says something
   *  else, and `""` for a page that should say nothing. */
  lead?: string;
  /** Optional sentence under the list - what the group covers beyond the entries. */
  note?: string;
  /** Photographs of the group as a whole, shown under the list and above the order block.
   *  Frames that belong to no single entry - see `PhotoStrip`.
   *
   *  **One row per page, and the overline is written here rather than passed in.** This was
   *  briefly a list of labelled rows, when `/chryzantemy/` carried a second strip of finished
   *  pots beside the crop; the owner had that strip removed in September 2026 and its frames
   *  moved into `chrysanthemumStrip`, so the list had exactly one element on every page that
   *  used it. The generality went with the strip it was added for. If a page ever needs two
   *  rows again, this is the prop that grows - see the note on `chrysanthemumStrip` in
   *  src/data/gallery.ts for the argument that would bring it back. */
  photos?: GalleryPhoto[];
}

/** The sentence every category page opens with.
 *
 *  **It lives here rather than in the page files**, which is where `title`, `note` and the
 *  meta description live. Those are page copy and differ page to page; this one is deliberately
 *  identical on every category page, and keeping a copy per page is what let them drift: by
 *  September 2026 the two balcony and bedding pages carried it and `/bratki/` and
 *  `/chryzantemy/` did not, which is the defect the owner reported. One copy cannot drift.
 *
 *  `/chryzantemy/` is the page that dropped it, and the reason does not apply any more. What
 *  the owners had removed there in September 2026 was a **different** sentence - "Duży wybór
 *  kolorów. Sprzedaż zaczyna się od początku października i trwa do 1 listopada." - because it
 *  repeated the selling dates and the colours that the entries' own facts and chips already
 *  carry. This one claims neither; it says where to look. docs/inwentaryzacja.md has both.
 *
 *  **It promised colours until September 2026 and does not any more.** The owners had the
 *  clause "i o kolorach dostępnych u nas" replaced with "i charakterystyce", which is what
 *  the four `facts` under every entry actually carry. Do not put the colours back: the
 *  "Dostępne kolory" chips left every entry in the same month, so the sentence was sending
 *  people to something that is no longer under a plant. Nineteen of the twenty-two entries
 *  that had chips still name their colours in their prose and three say nothing about colour
 *  at all, so the page cannot promise them either. */
const OFFER_LEAD =
  "Kwiaty z naszej uprawy. Przy każdej roślinie są najważniejsze informacje o jej uprawie i charakterystyce.";

const { group, title, lead = OFFER_LEAD, note, photos } = Astro.props;

/** Polish collation, not the default. `localeCompare` without a locale sorts "Łubin" past
 *  "Wrzos" and hides it at the end of the list, and files "Goździk" wherever the runtime's
 *  default happens to put it. With "pl-PL" both land where a Polish reader looks for them:
 *  Ł directly after L, ź inside G. */
const entries = (await getCollection("plants"))
  .filter((plant) => plant.data.group === group)
  .sort((a, b) => a.data.name.localeCompare(b.data.name, "pl-PL"));

if (entries.length === 0) {
  throw new Error(`No plants with group "${group}" - the page would have a heading and no list.`);
}

/** The initial a name is filed under. `toLocaleUpperCase("pl-PL")` rather than the plain one
 *  so that the cased letters this alphabet actually uses survive the round trip. */
const initialOf = (name: string): string => name.trim().charAt(0).toLocaleUpperCase("pl-PL");

/** The entries grouped by initial, in the order they already stand in - so this is a
 *  partition of a sorted list and never a second sort.
 *
 *  Feeds the index at the top. The list below reads the same grouping off `divider`, which is
 *  derived from the same array rather than recomputed, so the two cannot disagree about where
 *  a letter starts. */
const letterGroups: { letter: string; plants: typeof entries }[] = [];
for (const plant of entries) {
  const letter = initialOf(plant.data.name);
  const open = letterGroups.at(-1);
  if (open?.letter === letter) open.plants.push(plant);
  else letterGroups.push({ letter, plants: [plant] });
}

/** Each entry, with the letter to draw above it, or null where it continues the current one.
 *
 *  Kept as one flat list rather than rendering out of `letterGroups`, because `priority` needs
 *  the index of the entry on the page as a whole - the first photograph is the likely LCP
 *  element, and nesting the loop would make that "first of its letter" instead. */
const list = entries.map((entry, index) => ({
  entry,
  divider:
    index === 0 || initialOf(entries[index - 1]!.data.name) !== initialOf(entry.data.name)
      ? initialOf(entry.data.name)
      : null,
}));

/** The other category pages, in menu order. A visitor on one of them should not have to go
 *  back to the menu to reach the rest. */
const others = offerPages.filter((item) => item.href !== Astro.url.pathname);

/** "Sprzedaż trwa: marzec" while the window is open, "Sprzedaż wkrótce: ..." while it is the
 *  next one to open, and the bare dates the rest of the year. All three readings come out of
 *  `saleWindows`, the same table the season cards read. */
const saleWindow = windowFor(group);
const saleState = currentSeason.groups[group];
const months = saleWindow?.months.toLocaleLowerCase("pl-PL");
const saleLine = saleWindow
  ? saleState === "now"
    ? `Sprzedaż trwa: ${months}`
    : saleState === "soon"
      ? `Sprzedaż wkrótce: ${months}`
      : `Sprzedaż: ${months}`
  : null;
---

<section class="offer" aria-labelledby="offer-title">
  <div class="offer__head">
    <h1 class="offer__title" id="offer-title">{title}</h1>
    {lead && <p class="offer__lead">{lead}</p>}
  </div>

  {
    saleLine && (
      <p class:list={["offer__season", saleState === "now" && "offer__season--now"]}>{saleLine}</p>
    )
  }

  <p class="offer__count">{plantCount(entries.length)} w tej grupie</p>

  {
    entries.length > 1 && (
      <nav class="offer__index" aria-label="Spis roślin na tej stronie">
        <p class="offer__indexLabel">Na tej stronie</p>
        <dl class="offer__letters">
          {letterGroups.map((row) => (
            <div class="offer__lettersRow">
              <dt>{row.letter}</dt>
              <dd>
                <ul>
                  {row.plants.map((plant) => (
                    <li>
                      <a href={`#${plant.id}`}>{plant.data.name}</a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </nav>
    )
  }

  <div class="offer__list">
    {
      list.map(({ entry, divider }, index) => (
        <Fragment>
          {divider && (
            <p class="offer__letter" aria-hidden="true">
              {divider}
            </p>
          )}
          <PlantEntry
            entry={entry}
            level={2}
            priority={index === 0}
            backToIndex={entries.length > 1}
          />
        </Fragment>
      ))
    }
  </div>

  {note && <p class="offer__note">{note}</p>}

  <p class="offer__prices">
    Ceny detaliczne i hurtowe przy większych ilościach ustalamy na miejscu lub telefonicznie.
    Istnieje możliwość dowozu własnym transportem.
  </p>

  {photos && photos.length > 0 && <PhotoStrip photos={photos} label="Zdjęcia z gospodarstwa" />}

  <div class="offer__order">
    {/* See `Contact.astro` - "Sklepu internetowego nie prowadzimy" lives on `/faq/` alone. */}
    <p class="offer__orderText">
      Zamówienia przyjmujemy telefonicznie oraz na terenie gospodarstwa.
    </p>
    <div class="offer__actions">
      <a class="cta" href={primaryPhone.href}>Zadzwoń: {primaryPhone.display}</a>
      <a class="cta-line" href="/kontakt/">Kontakt i dojazd</a>
    </div>
  </div>

  <nav class="offer__others" aria-label="Pozostałe grupy">
    <p class="offer__othersLabel">Pozostałe grupy</p>
    <ul>
      {
        others.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<style>
  .offer {
    padding: var(--pad-section) var(--edge) clamp(1.5rem, 3vw, 2rem);
  }

  /* Baseline row: the heading and the sentence beside it sit on one line on a wide screen
     and stack on a narrow one, without a breakpoint deciding which. */
  .offer__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.9rem;
  }

  .offer__title {
    font-size: var(--text-h2);
  }

  .offer__lead {
    max-width: 42ch;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  /* The selling window, directly under the heading - the first thing someone arriving from
     search needs, and the only line on the page that changes with the build date. */
  .offer__season {
    padding-top: 0.9rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .offer__season--now {
    font-weight: 600;
    color: var(--green);
  }
  .offer__season + .offer__count {
    padding-top: 0.35rem;
  }

  /* A counter - see .eyebrow in global.css for where the accent may and may not go. */
  .offer__count {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ochre);
    padding-top: 0.9rem;
  }

  .offer__index {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.6rem;
  }

  .offer__indexLabel {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }

  .offer__index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .offer__index a {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-link);
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .offer__index a:hover {
    color: var(--green);
    border-bottom-color: var(--green);
  }

  /* The index every category page now gets, sized by the longest of them. Seventeen initials
     over thirty-four plants would be seventeen full-width rows - a screen and a half of index
     standing in front of the first plant - so the rows run in columns: three on a desktop, one
     on a phone, decided by `column-width` rather than by a breakpoint. A page with one or two
     rows simply leaves the other columns empty, which is what a short index looks like in
     print too; it is not worth a second rule to collapse them.

     **Columns and not a grid, because a grid aligns its rows across the tracks.** That is what
     it is for and it was wrong here: the P row holds four names and wraps to three lines, and
     every grid row is as tall as its tallest cell, so the two cells beside P were padded out
     into a hole under "Orlik" and "Szałwia". Multi-column packs each column independently and
     there is nothing left to pad.

     It also puts the alphabet where a reader of any printed index expects it - down a column
     and on to the next, A-G, H-N, O-W, rather than across the page in rows. The DOM stays in
     one alphabetical order either way, so the tab order and what a screen reader reads are
     untouched by the choice. */
  .offer__letters {
    columns: 3 300px;
    column-gap: 2rem;
  }

  /* The initial in a fixed first track and the names wrapping in the second, so the letters
     line up down each column. This is the contact list's grid and it is here for the contact
     list's reported defect: laid out with flex, every row starts wherever its own first word
     happens to end, and a column of initials that does not line up is not an index.

     `break-inside` keeps a letter with its plants: without it a column can end between the "H"
     and "Hortensja". `margin-bottom` does the vertical spacing rather than the parent's `gap`,
     which multi-column has no equivalent of. */
  .offer__lettersRow {
    display: grid;
    grid-template-columns: 2.5ch 1fr;
    gap: 0.3rem 0.9rem;
    align-items: baseline;
    border-top: 1px solid var(--rule);
    padding-top: 0.5rem;
    margin-bottom: 0.5rem;
    break-inside: avoid;
  }

  .offer__lettersRow dt {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--ink-grey);
  }

  /* Tighter than the flat index above, which has a whole row to itself per line; here the names
     share their row with the letter and several rows share a screen. */
  .offer__lettersRow dd ul {
    gap: 0.3rem 1.5rem;
  }

  .offer__list {
    display: grid;
  }

  /* A waypoint between entries, and deliberately not a heading: the outline of this page is one
     h1 and one h2 per plant, and a letter names nothing that stands under it. `aria-hidden`
     follows from the same thing - a screen reader moves through this page by plant name, and a
     lone "A" announced between two entries is noise. The letters reach that reader through the
     index above, which is a real nav with real links.

     **It draws no line, and that is the whole point of the second attempt.** The first one set
     the letter beside a 1px --rule running off to the right, which was one hairline too many:
     every .entry already closes with a 1px --rule of its own, so the page alternated
     "line, letter+line, line" and the two marks were the same weight and the same colour doing
     two different jobs. The owner reported exactly that - the letter's line and the entry's line
     blurred into each other. A page gets one kind of horizontal line; on this one it means "an
     entry ended".

     So the letter carries the break by itself, with the other two things this design has:
     **size and spacing.** It is set well above a plant name, which no heading here is, and the
     space is deliberately lopsided - a large gap above, none below - so proximity attaches it to
     the plants that follow rather than leaving it floating between two of them. That asymmetry
     is the part that makes it read at a glance.

     --sage rather than --ink or --ink-grey, and the size is what licenses it: tokens.css
     restricts this green to decorative type at 24px and up (3.9:1, which clears the 3:1 WCAG
     asks of large text but not the 4.5:1 it asks of body). This letter is decorative by
     construction - it is aria-hidden - and never smaller than 40px. The same green must not
     travel up to the index's <dt>, which sits at 20px; that one stays --ink-grey. */
  .offer__letter {
    padding-block: clamp(2.75rem, 6vw, 4.5rem) 0;
    font-family: var(--serif);
    font-size: clamp(2.5rem, 1.9rem + 2.6vw, 4rem);
    line-height: 0.9;
    color: var(--sage);
  }

  .offer__note,
  .offer__prices {
    max-width: 62ch;
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .offer__order {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--rule);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .offer__orderText {
    max-width: 52ch;
    color: var(--ink-soft);
  }

  .offer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    align-items: center;
  }

  .offer__others {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--rule);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.6rem;
  }

  .offer__othersLabel {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }

  .offer__others ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .offer__others a {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-link);
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .offer__others a:hover {
    color: var(--green);
    border-bottom-color: var(--green);
  }
</style>
