---
import Nav from "./Nav.astro";

/**
 * The name and the menu bar, separated by a rule.
 *
 * The name is **not** an `h1` any more. It was, and the same `h1` then appeared on every
 * page - naming the business rather than the page's subject, and pushing the 404 page's
 * own title down to `h2`. The site name is identity, not the heading of the document; the
 * `h1` now lives in the page (Intro on the home page, 404.astro on the error page).
 *
 * It is a link to `/`, which is what visitors try when a masthead looks like one.
 *
 * The subtitle is the exact tagline from the current site and is not to be reworded
 * (docs/design/README.md, section 1). There is no logotype - the name is typographic.
 */
---

<header>
  <div class="masthead">
    <p class="masthead__name">
      <a href="/">Gospodarstwo Ogrodnicze <em>„Saran”</em></a>
    </p>
    <p class="tagline">Sprzedaż kwiatów balkonowych, rabatowych i chryzantem</p>
  </div>
  <Nav />
</header>

<style>
  header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .masthead {
    padding: clamp(1.5rem, 4vw, 2.75rem) var(--edge) clamp(1rem, 2vw, 1.5rem);
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    text-align: center;
  }

  /* Same type as the old h1, down to the letter-spacing - only the tag changed. */
  .masthead__name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--text-h1);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .masthead__name a {
    color: inherit;
    text-decoration: none;
  }

  /* The one italic on the site. Instrument Serif's italic is loaded for this word alone -
     see src/styles/fonts.css. */
  .masthead__name em {
    font-style: italic;
    color: var(--green);
  }

  .tagline {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }
</style>
