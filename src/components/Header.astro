---
import Nav from "./Nav.astro";

/**
 * The name, the tagline and the menu - three storeys, all centred.
 *
 * The name sits centre stage at its own scale (--text-masthead), with the full-width menu
 * bar under it on a faint --paper-linen ground and a rule of its own - as on the current
 * site, because that bar is liked and it tidies the top of the screen.
 *
 * The "name on the left, menu on the right, one row" version was rejected: eight items do
 * not fit beside the name below ~1150px, and wrapping dropped the whole bar under the name
 * flush right, with an empty hole on the left.
 *
 * Critical to the alignment: `<Nav />` stands **outside** the name's padding, as the second
 * row of the header grid. The bar then has its own `padding-inline: var(--edge-nav)` and
 * nothing is added twice - that double margin was the source of the misalignment, not the
 * background itself.
 *
 * The tagline belongs here and stays here. Version 0.5 moved it into the footer's first
 * column to keep the header down to two storeys - but docs/design/README.md section 1 puts
 * it in the header, CLAUDE.md names it among the things that are easy to get wrong, and in
 * the footer it landed one line above a blurb that says the same thing at greater length.
 * Changing the specification is not a decision to take in a code comment; it goes back
 * where it belongs until the owners say otherwise - and then it is written down in docs/,
 * not here.
 *
 * The wording is that of the current site, word for word, and is not open to editing.
 *
 * Three storeys cost about 30px of height against two; the name keeps its full scale.
 *
 * The name is still not an `h1`; the `h1` belongs to the page.
 */
---

<header>
  <p class="name">
    <a href="/">Gospodarstwo Ogrodnicze <em>„Saran”</em></a>
  </p>
  <p class="tagline">Sprzedaż kwiatów balkonowych, rabatowych i chryzantem</p>
  <Nav />
</header>

<style>
  header {
    display: grid;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .name {
    padding: clamp(1.1rem, 2.5vw, 1.75rem) var(--edge-nav) 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--text-masthead);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-align: center;
    text-wrap: balance;
  }

  .name a {
    color: inherit;
    text-decoration: none;
  }

  /* The header's bottom spacing now hangs on the tagline rather than on the name - the two
     are meant to sit tight together, because they are one unit and not two rows. */
  .tagline {
    padding: 0.55rem var(--edge-nav) clamp(0.9rem, 2vw, 1.35rem);
    font-family: var(--sans);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-grey);
    text-align: center;
    text-wrap: balance;
  }

  /* The only italic on the site, and the only place --sage may be used: the name is always
     >=24.8px, so 3.9:1 falls inside AA for large type. */
  .name em {
    font-style: italic;
    color: var(--sage);
  }
</style>
