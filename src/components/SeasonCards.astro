---
import { Picture } from "astro:assets";
import { currentSeason, saleWindows, type SaleWindow, type SaleState } from "../data/season";
import { chrysanthemumPhoto, pansyPhoto } from "../data/gallery";
import { compositionPhoto } from "../data/compositions";

/**
 * The selling year, window by window, with the window that is running - or, between
 * windows, the one opening next - filled in dark.
 *
 * The section has a heading of its own and the cards sit under it as `h3`. Before, each card
 * title was an `h2`, so the middle card's heading of the day - "Sprzedaż w okresie
 * wiosennym", a wording this file no longer carries - stood in the document outline at the
 * same level as the offer, the gallery and the contact section - the cards read as top-level
 * sections, and the block they belong to had no name at all.
 *
 * **There are three of them, where the handoff draws two** (docs/design/README.md, section
 * 3). The pansies the owners added in September 2026 sell before the balcony flowers do,
 * months the spring card used to swallow: a visitor in March got a photograph of a
 * balcony-flower tunnel and a card describing the one thing not on sale. One card per selling
 * window fixes that and costs the design nothing - the grid is `auto-fit`, so the third card
 * is a third column where there is room and a third row where there is not.
 *
 * ## This is where the season is told
 *
 * The dark `.card--lit` block and the "W trakcie" / "Wkrótce" overline live here and
 * nowhere else. 0.9
 * moved them to the offer tiles for one release and moved them back: the tiles are a menu,
 * four equal doors to four pages, and a menu is the wrong place to say what month it is. The
 * question "what is happening in the garden right now" is this block's whole subject, and it
 * is the only block on the page with the room - a dark panel, a photograph and three
 * sentences - to answer it properly.
 *
 * **"Wkrótce" is told here too**, on the window that opens next while none is open: between
 * July and September the autumn card says it, from November to February the spring one does.
 * It lights the same dark ground as "W trakcie" - the owners asked for that explicitly. The
 * two states are told apart by the overline and nothing else, which is enough because they
 * never appear together: the rule in `season.ts` puts at most one card in either state, so
 * the page always has exactly one dark card or none, and never two saying different things.
 *
 * ## What the cards no longer do
 *
 * They carry no link. Three of the four offer pages used to be linked twice on the home page,
 * a screen apart, in the same photograph-heading-paragraph-link shape - the repetition
 * `ContactStrip` was deleted for in 0.6 - and the middle card could not tell the truth
 * anyway: April to June sells balcony *and* bedding flowers, off two pages, from one card.
 * The way to a page is the offer tiles below, which have one door per page.
 *
 * The months come from `saleWindows` rather than from copy typed in here, so this block and
 * the category pages cannot end up quoting different dates - which is exactly what had
 * happened to `/bratki/`, still advertising a window the owners had changed.
 */
/** The spring card's frame: the brief asks for "galeria - tunel z kwiatami balkonowymi".
 *
 *  Asked for **by name**, like the history block's photograph. It used to be `gallery[17]`,
 *  an array position in the photograph registry - which meant the card silently depended on
 *  the order of a list it has nothing to do with. */
const tunnelPhoto = await compositionPhoto("rozowo-biala-wystawa-kalibrachoi");

const stateFor = (window: SaleWindow): SaleState | null =>
  window === currentSeason.open ? "now" : window === currentSeason.soon ? "soon" : null;

const stateLabel: Record<SaleState, string> = { now: "W trakcie", soon: "Wkrótce" };

const cards = [
  {
    window: saleWindows[0]!,
    season: "Wczesna wiosna",
    title: "Bratki i prymulki",
    body: "Zaczynamy sezon od kolorowych bratków i prymulek w skrzynkach i doniczkach. Sprzedajemy je w marcu, jeszcze zanim ruszą kwiaty balkonowe i rabatowe.",
    meta: saleWindows[0]!.months,
    photo: pansyPhoto,
  },
  {
    window: saleWindows[1]!,
    season: "Wiosna",
    title: "Wiosenny sezon",
    body: "Kwiaty balkonowe i rabatowe, rozsady oraz gotowe kompozycje. Duży wybór kolorów i odmian czeka na miejscu, w naszym gospodarstwie.",
    // "szczyt sezonu" is the handoff's own wording; only the months in front of it moved.
    meta: `${saleWindows[1]!.months} · szczyt sezonu`,
    photo: tunnelPhoto,
  },
  {
    window: saleWindows[2]!,
    season: "Jesień",
    title: "Chryzantemy",
    body: "Jesienią oferujemy chryzantemy wielkokwiatowe w wielu kolorach i odmianach. Zamówienia na Wszystkich Świętych warto złożyć około tygodnia wcześniej.",
    meta: saleWindows[2]!.months,
    photo: chrysanthemumPhoto,
  },
] as const;
---

<section class="seasons" aria-labelledby="sezon-title">
  <div class="seasons__head">
    <h2 class="seasons__title" id="sezon-title">Kiedy co sprzedajemy</h2>
  </div>

  <div class="seasons__grid">
    {
      cards.map((card) => {
        const state = stateFor(card.window);
        return (
          <article class:list={["card", state && "card--lit"]}>
            <p class="card__eyebrow">{state ? stateLabel[state] : card.season}</p>
            <h3 class="card__title">{card.title}</h3>
            <p class="card__body">{card.body}</p>
            <div class="card__slot">
              <Picture
                src={card.photo.src}
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                widths={[640, 1280]}
                sizes="(min-width: 1200px) 400px, (min-width: 700px) 45vw, 90vw"
                width={640}
                height={360}
                alt={card.photo.alt}
                loading="lazy"
              />
            </div>
            <p class="card__meta">{card.meta}</p>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  /* A dark plate since September 2026, and the first of three on the home page. It needs no
     border of its own: the hero closes with a rule above it and the offer tiles open with one
     below it, and on a ground this different from both neighbours a line would add nothing.

     Colours are named rule by rule rather than remapped on the container - the .history and
     .footer way. This block holds five kinds of element; remapping is what Compositions does
     and it is worth its weight only where a second copy of 250 lines of CSS would rot. */
  .seasons {
    background: var(--green-band);
    color: var(--bone);
    /* Dark ground: the default ring is 1.67:1 here. See tokens.css. */
    --focus-ring: var(--green-lit);
    padding: var(--pad-section) var(--edge);
    display: grid;
    gap: 1.75rem;
  }
  .seasons__head {
    border-bottom: 1px solid rgb(238 240 230 / 22%);
    padding-bottom: 0.9rem;
  }
  .seasons__title {
    font-size: var(--text-h2);
    color: var(--bone);
  }

  .seasons__grid {
    display: grid;
    gap: 1.5rem;
    /* The three cards sit in one row until one of them would be narrower than 320px, then
       they reflow - three across on a desktop, two and one on a tablet, stacked on a phone.
       No media query decides that; the 320px in the handoff still does. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  /* Flex column rather than grid, and for the same reason as the offer tiles: `margin-top:
     auto` on the photograph. The three bodies run to different lengths - the pansy card is
     two lines longer than the chrysanthemum one - and with the rows packed to the top the
     three photographs and the three date lines sat at three different heights across one row.
     The cards were always the same height; it was their insides that were irregular. */
  .card {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    /* Outline only. A filled card on this plate would need a fourth green, and the border is
       already how every other card on the site is bounded. */
    border: 1px solid rgb(238 240 230 / 30%);
    background: transparent;
  }
  /* **The lit card is the light one, and that is the whole of the inversion.** On the old
     cream band this card was the dark panel; on a dark band a dark panel is invisible - it was
     --green-deep on a --green-deep ground, 1.00:1, a card that renders and cannot be seen.
     Turning it into the light plate keeps the word honest: the card whose season is running is
     the one that is lit. Everything inside it goes back to the ink palette, because it is now
     a piece of paper lying on the plate. Nothing in it is focusable, so it needs no
     --focus-ring raise; it carried a link until 0.9 and that is why it used to. */
  .card--lit {
    border-color: var(--paper);
    background: var(--paper);
  }
  .card__eyebrow {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ochre-lit);
  }
  .card--lit .card__eyebrow {
    color: var(--ochre);
  }
  .card__title {
    font-size: var(--text-h2-card);
    line-height: 1.1;
    color: var(--bone);
  }
  .card--lit .card__title {
    color: var(--ink);
  }

  .card__body {
    max-width: 46ch;
    color: var(--green-body);
  }
  .card--lit .card__body {
    color: var(--ink-soft);
  }

  /* Pushes itself and the date line below it to the foot of the card, so all three line up. */
  .card__slot {
    margin-top: auto;
    padding-top: 0.35rem;
  }

  /* All three cards hold a real photograph, and each keeps the 16:9 box the placeholders had -
     the handoff asks for the aspect ratio and the 1px border to survive the substitution
     (docs/design/README.md, "Fidelity" and "Assets"). The sources are portrait; `cover` is
     what crops them to the frame. */
  .card__slot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid rgb(238 240 230 / 30%);
  }
  .card--lit .card__slot :global(img) {
    border-color: var(--rule);
  }

  .card__meta {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--green-lit);
  }
  .card--lit .card__meta {
    color: var(--ink-grey);
  }
</style>
