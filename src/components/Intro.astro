---
import { Picture } from "astro:assets";
import { primaryPhone } from "../data/contact";
import { homeHeroPhoto } from "../data/gallery";

/**
 * The first thing under the menu on the home page: what the holding sells and the two ways
 * to act on it.
 *
 * This carries the page's `h1`. It used to be in the masthead, where it named the business
 * on every page instead of naming the page - see Header.astro. The heading text is the one
 * from the `<title>`, so the two agree.
 *
 * "Zachęcamy do zapoznania się z naszą ofertą." is the owners' own opening line and is
 * kept - it moved into the paragraph, because a sentence of welcome is not a heading.
 *
 * The phone number is written into the button's label rather than hidden behind "Zadzwoń",
 * because most of the people who use it are reading it off a screen and dialling on a
 * different device.
 *
 * ## The photograph
 *
 * Not in the design handoff, which has this section as text only; added on the owners' own
 * request. It first shipped as a 3:4 portrait below the buttons, which left the page
 * opening on a column of centred text with a picture parked underneath it. The owners
 * asked for it as the ground of the band instead, so it is now full-bleed with the welcome
 * on top of it.
 *
 * That is a third dark block rather than a new idiom: the type, the colours and the flat
 * (never gradient) overlay are the ones "Historia" and the footer already use, and the
 * photograph stands in for their flat green. The one thing it changes is the focus ring,
 * which is recoloured - not removed - because --green is invisible against a darkened
 * photograph.
 *
 * It is the LCP element on `/`, so it loads eager rather than joining the lazy queue
 * everywhere else uses.
 */
---

<section class="hero">
  <div class="hero__frame">
    <Picture
      class="hero__photo"
      src={homeHeroPhoto.src}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[480, 768, 1024, 1280, 1500, 2048]}
      sizes="100vw"
      alt={homeHeroPhoto.alt}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__content">
    <h1 class="hero__title">Kwiaty balkonowe, rabatowe i chryzantemy z własnej uprawy</h1>
    <p class="hero__body">
      Zachęcamy do zapoznania się z naszą ofertą. Zamówienia można składać telefonicznie lub na
      terenie naszego gospodarstwa w Cholewiance pod Kazimierzem Dolnym. Wszystko, co sprzedajemy,
      pochodzi z naszej własnej uprawy.
    </p>
    <div class="actions">
      <a class="cta" href={primaryPhone.href}>Zadzwoń: {primaryPhone.display}</a>
      <a class="cta-line" href="/kwiaty-balkonowe/">Zobacz ofertę</a>
    </div>
  </div>
</section>

<style>
  /* Photograph, scrim and text are three layers of one grid cell. No absolute positioning
     for the content: the band is at least `min-height` tall and grows past it if the copy
     ever does, instead of being a fixed box the text can overflow. */
  .hero {
    display: grid;
    isolation: isolate;
    /* The desktop image is deliberately a broad 2048Ã—746 banner. The mobile rule below
       lets the content grow instead of squeezing it into that shallow landscape ratio. */
    aspect-ratio: 2048 / 746;
    color: var(--paper);
  }

  .hero__frame,
  .hero__content {
    grid-area: 1 / 1;
  }

  .hero__frame {
    position: relative;
    overflow: hidden;
  }

  /* <Picture> renders <picture><img>; the wrapper is inline by default, which would leave
     the image sitting on a text baseline with a gap under it. */
  .hero__frame :global(picture) {
    display: block;
    height: 100%;
  }

  .hero__photo {
    width: 100%;
    /* Beats the `height: auto` global.css puts on every img. */
    height: 100%;
    object-fit: cover;
    /* Keep the layered flower bed prominent when the image is cropped on narrow screens. */
    object-position: center 28%;
  }

  /* The photo stays bright above; only the copy's lower part receives enough shade for
     readable text and buttons. */
  .hero__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--scrim-hero);
  }

  .hero__content {
    z-index: 1;
    align-self: end;
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    text-align: left;
    padding: clamp(1.4rem, 3vw, 2.5rem) max(var(--edge), 7vw);
  }

  /* The h1 token, at last used by an h1. It was --text-lead while this was a paragraph of
     text on paper; as the one line on a full-bleed photograph it carries the band. */
  .hero__title {
    font-size: var(--text-h1);
    line-height: 1.08;
    max-width: 15ch;
    text-wrap: balance;
  }

  .hero__body {
    max-width: 42ch;
    /* The paragraph colour "Historia" uses on its dark ground. */
    color: var(--green-body);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    justify-content: start;
    margin-top: 0.25rem;
  }

  /* Both buttons invert on the dark band: --green-deep on a darkened photograph is a
     button-shaped smudge. The shape, size and 50px/44px targets are untouched. */
  .cta {
    color: var(--ink);
    background: var(--paper);
  }
  .cta:hover {
    color: var(--ink);
    background: var(--green-lit);
  }

  .cta-line {
    color: var(--paper);
    border-bottom-color: var(--paper);
  }
  .cta-line:hover {
    color: var(--green-lit);
    border-bottom-color: var(--green-lit);
  }

  /* Recoloured, never removed. --green (#4E5C40) is the ring everywhere else on the site
     and all but disappears against this ground; --green-lit is the pale green the dark
     blocks already use for the same reason. */
  .hero :focus-visible {
    outline-color: var(--green-lit);
  }

  @media (width < 700px) {
    .hero {
      aspect-ratio: auto;
      min-height: 40rem;
    }
  }
</style>
