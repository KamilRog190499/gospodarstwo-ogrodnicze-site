---
import { Picture } from "astro:assets";
import { tunnelPhoto } from "../data/gallery";
import { directionsUrl, primaryPhone } from "../data/contact";

/**
 * Wejście na stronę główną: zdjęcie tunelu na pełną szerokość, `h1` na nim, pod spodem
 * zdanie powitalne i trzy sposoby działania.
 *
 * Do wersji 0.5 to była wyśrodkowana kolumna tekstu na kremowym tle. Gospodarstwo ma od
 * września 35 własnych zdjęć, a strona główna nie pokazywała ani jednego powyżej zgięcia —
 * pierwszą fotografią była miniatura w karcie sezonu. Zdjęcie tunelu jest tym, co
 * odwiedzający próbuje sobie wyobrazić, czytając „przyjedź i obejrzyj na miejscu”.
 *
 * `h1` leży na zdjęciu, więc czytelność zależy od przyciemnienia (--hero-scrim), nie od
 * szczęścia w kadrze. Padding górny scrimu jest częścią tego rachunku, nie odstępem, i
 * działa odwrotnie, niż podpowiada intuicja: scrim jest zakotwiczony dołem, więc **większy**
 * padding czyni go wyższym i spycha tekst na niższy ułamek jego wysokości, czyli w gęstszą
 * alfę. W kadrze 3:1 padding jest krótszy (2,75rem zamiast 5,5rem), żeby gradient mieścił
 * się w zdjęciu — i dlatego zbocze w --hero-scrim jest za to gęstsze. Te dwie liczby to
 * jeden rachunek w dwóch plikach: zmiana jednej wymaga przeliczenia drugiej.
 *
 * Krytycznym elementem jest etykieta nad nagłówkiem, nie nagłówek: jest najwyżej, więc
 * dostaje najrzadszą część gradientu, a przy 10,5px potrzebuje 4,5:1 tam, gdzie nagłówek
 * przy 46px potrzebuje 3:1. Dwie wersje z rzędu przeszły na nagłówku i oblały na etykiecie.
 *
 * Obecne wartości: etykieta ~5,2:1, nagłówek ~7:1 nad najjaśniejszym fragmentem tunelu.
 * Zmiana paddingu albo długości nagłówka wymaga ponownego pomiaru **etykiety**.
 *
 * `loading="eager"` i `fetchpriority="high"` — to jest LCP strony głównej i nie ma sensu
 * udawać, że jest inaczej.
 *
 * 3:1 (i 3:2 na telefonie) to kadr, nie krop: `object-fit: cover` na pionowym oryginale wycina środek. Jeśli
 * właściciele dadzą kiedyś kadr panoramiczny, wystarczy podmienić `tunnelPhoto`.
 *
 * Trzeci przycisk („Wyznacz trasę”) jest nowy: adres był dotąd tylko w prozie i w stopce,
 * a „gdzie to jest” to pierwsze pytanie kogoś, kto kupuje na miejscu.
 */
---

<section class="intro">
  <div class="intro__hero">
    <Picture
      class="intro__photo"
      src={tunnelPhoto.src}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[960, 1600, 2400]}
      sizes="100vw"
      width={1600}
      height={686}
      alt={tunnelPhoto.alt}
      loading="eager"
      fetchpriority="high"
    />
    <div class="intro__scrim">
      <p class="intro__place">Cholewianka pod Kazimierzem Dolnym</p>
      <h1 class="intro__title">Kwiaty balkonowe, rabatowe i chryzantemy z własnej uprawy</h1>
    </div>
  </div>

  <div class="intro__below">
    <p class="intro__body">
      Zachęcamy do zapoznania się z naszą ofertą. Zamówienia można składać telefonicznie lub na
      terenie naszego gospodarstwa. Wszystko, co sprzedajemy, pochodzi z naszej własnej uprawy.
    </p>
    <div class="intro__actions">
      <a class="cta" href={primaryPhone.href}>Zadzwoń: {primaryPhone.display}</a>
      <a class="cta-line" href="/kwiaty-balkonowe/">Zobacz ofertę</a>
      <a class="cta-line" href={directionsUrl} target="_blank" rel="noopener">Wyznacz trasę</a>
    </div>
  </div>
</section>

<style>
  .intro {
    border-bottom: 1px solid var(--rule);
  }

  /* Zdjęcie i scrim leżą w jednej komórce siatki, oba jako elementy siatki — scrim nie
     jest pozycjonowany absolutnie. To jest warunek poprawności, nie styl: scrim jest
     kotwiczony dołem, a jego wysokość bierze się z długości nagłówka, nie z kadru.
     Poniżej ~390px nagłówek łamie się na tyle wierszy, że scrim jest wyższy niż kadr 3:2
     i — jako element absolutny — wychodził górą poza zdjęcie, kładąc szarą smugę na
     papierze nad nim (na 360px 11px, na 320px 91px). Przycięcie `overflow: hidden` jest
     tu pułapką: obcina wtedy etykietę i górę nagłówka. Jako element siatki scrim
     współtworzy wysokość pasa, więc to kadr rośnie do tekstu, a nie tekst wychodzi poza
     kadr. Gęstość gradientu i padding scrimu zostają nietknięte — pomiar etykiety
     i nagłówka jest ten sam. */
  .intro__hero {
    display: grid;
    /* Jawna kolumna, nie domyślna `auto`: ścieżka `auto` mierzy się max-content swoich
       elementów, a odkąd scrim jest elementem siatki, jego max-content (nierozłamany
       nagłówek plus etykieta) rozpychał pas do 520px na ekranie 320px i dawał poziomy
       pasek przewijania na całej stronie. `minmax(0, 1fr)` przypina kolumnę do szerokości
       kontenera i pozwala zawartości się złamać. */
    grid-template-columns: minmax(0, 1fr);
  }

  /* <Picture> renderuje <picture><img>; elementem siatki jest owijka, więc kadr siedzi na
     niej. `min-height: 100%` dorasta do wiersza, kiedy scrim okaże się wyższy niż kadr;
     samo `align-self: stretch` tu nie działa, bo element z `aspect-ratio` się nie
     rozciąga, a `height: 100%` rozpychałoby szerokość proporcją. */
  .intro__hero > :global(picture) {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    min-height: 100%;
    /* Na telefonie 3:1 zostawia pasek zdjęcia wysokości palca; 3:2 daje tam kadr, w którym
       widać, co jest w tunelu. Jedyne media query w projekcie i świadomie: to jest wybór
       kadru, a nie układu, więc auto-fit go nie załatwi. */
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 700px) {
    .intro__hero > :global(picture) {
      aspect-ratio: 3 / 1;
      /* Panorama 3:1 sama w sobie zjeżdża pod wysokość, którą scrim potrzebuje na etykietę
         i h1 — bez tego dolnego progu gradient wypełnia cały kadr i z fotografii nie zostaje
         nic. Próg jest liczony pod najwyższą treść scrimu, nie pod “wygląd”. `max(100%, …)`
         zamiast samego progu, żeby dorastanie do wiersza zostało w mocy. */
      min-height: max(100%, clamp(400px, 34vw, 560px));
    }
  }

  .intro__photo {
    display: block;
    width: 100%;
    /* Bije `height: auto`, które global.css nakłada na każdy img. */
    height: 100%;
    object-fit: cover;
  }

  .intro__scrim {
    grid-area: 1 / 1;
    align-self: end;
    padding: clamp(1.5rem, 4vw, 2.75rem) var(--edge) clamp(1.25rem, 3vw, 2.25rem);
    background: var(--hero-scrim);
    display: grid;
    gap: 0.6rem;
  }

  .intro__place {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-lit);
  }

  .intro__title {
    font-size: var(--text-h1);
    line-height: 1.08;
    color: var(--paper);
    max-width: 20ch;
    text-wrap: balance;
  }

  .intro__below {
    padding: clamp(1.75rem, 4vw, 2.5rem) var(--edge) clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: 1.15rem;
  }

  .intro__body {
    max-width: 56ch;
    color: var(--ink-soft);
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    align-items: center;
  }
</style>
