---
import { Picture, getImage } from "astro:assets";
import { getCollection, render } from "astro:content";
import { compositionKinds } from "../data/compositions";
import { plantLinks } from "../data/plant-links";
import { primaryPhone } from "../data/contact";

/**
 * The plantings - `/inspiracje/` in full, and the home page in a reduced variant.
 *
 * Replaces `Slideshow.astro`. That component's good parts are kept verbatim and its one
 * real fault is the reason this file exists.
 *
 * **Kept.** It is still a scroll-snap track, so with no JavaScript the page is still a
 * scrollable strip holding every frame - nothing hides behind a script. The auto-advance is
 * still timid (pauses on hover and focus, stops for good on the first interaction, never
 * runs under `prefers-reduced-motion`). The owners asked for a slideshow; this is still one.
 * Do not quietly turn it into a grid.
 *
 * **Changed.** A slide was a photograph in a queue: no name, no address of its own, and not
 * one link out. Someone who had just seen a basket they liked could not get from it to the
 * plant or to the phone - on the most sales-shaped page of the site. A slide is now a
 * *planting*: a container type, a short name, its plants as links into the offer entries,
 * an anchor, and the phone number.
 *
 * ## Where a planting lives
 *
 * In `src/content/compositions/`, one Markdown file each, the file name being the anchor.
 * They were a field on the photograph registry while a planting was a name and a list of
 * plants; the owners' September 2026 pass gave each one a paragraph of description and a
 * paragraph of advice, and that much prose belongs in Markdown. The same pass named the
 * species in the fifteen plantings that used to print "obsadzenie mieszane - gatunki do
 * wpisania przez gospodarstwo", so **that caveat is gone**: the names on this page are the
 * holding's own word now, not a reading of the photographs.
 *
 * Heading outline: `h1` for the page, then one `h2` per planting inside its own `figcaption`.
 *
 * **The photograph carries its own `alt` again.** It was `alt=""` while the caption printed
 * the very same sentence, which would have made a screen reader read it twice. The caption
 * now carries the editorial description - a different text with a different job - so the
 * literal description of the frame goes back where it belongs.
 *
 * ## The home page variant
 *
 * The home page shows the same 23 plantings with `level={2}` and the navigation aids off.
 * Five of the props exist to keep two copies of one thing from lying about each other, and
 * none of them is a matter of taste:
 *
 * - `prose` - the description and the advice are ~2000 words between them. On the home page
 *   they would turn a preview into a second, longer copy of `/inspiracje/`, and leave that
 *   page with no reason to exist. The strip up here says what the planting is and what is in
 *   it; the words are what the click is for.
 * - `structuredData` - the `ItemList` names `/inspiracje/#...` as the `@id` of every planting.
 *   Emitting it at a second address describes the same list twice, and `representativeOfPage`
 *   would be false on a page whose representative image is the hero.
 * - `ids` - `id={entry.id}` would put 23 anchors under `/#kosz-...` competing with the real
 *   ones under `/inspiracje/#kosz-...`. The home strip has no rail to jump with, so it needs
 *   none of them; `compositions.ts` is written to survive their absence.
 * - `showRail`, `showFilters` - the reduced variant is the strip, the buttons and the
 *   counter. Filtering and browsing all 23 by thumbnail are what `/inspiracje/` is for, and
 *   the panel headings link there.
 *
 * The per-panel phone CTA is gated on `level` for the same class of reason and is the one
 * that bites hardest: 23 panels would put `602 518 401` on the home page 23 times over.
 *
 * `eager` on the first photograph belongs to `/inspiracje/`, where it is the LCP. On the
 * home page the LCP is the hero in `Intro.astro`, which asks for `fetchpriority="high"` -
 * a second eager image would only compete with it for bandwidth.
 */
interface Props {
  /** `1` where the strip is the page, `2` where it is a section on another one. */
  level?: 1 | 2;
  showFilters?: boolean;
  showRail?: boolean;
  /** Emit the `ItemList`. One address only - see the note above. */
  structuredData?: boolean;
  /** Give each panel the planting's id as an anchor. One address only. */
  ids?: boolean;
  /** Print the description and "Nasza podpowiedź". Off in the reduced variant. */
  prose?: boolean;
  /** Add "Zobacz wszystkie obsadzenia" under the strip, pointing at `/inspiracje/`. */
  allLink?: boolean;
  /** Which ground the band sits on. `"dark"` is the home page only - see the note above. */
  ground?: "paper" | "dark";
}

const {
  level = 1,
  showFilters = true,
  showRail = true,
  structuredData = true,
  ids = true,
  prose = true,
  allLink = false,
  ground = "paper",
} = Astro.props;

const Heading = `h${level}` as "h1" | "h2";
const PanelHeading = level === 1 ? "h2" : "h3";

const entries = (await getCollection("compositions")).sort((a, b) => a.data.order - b.data.order);

/** Everything one panel needs, resolved once.
 *
 *  The lightbox target is the full frame at what the sources actually hold. `Slideshow`
 *  asked for 1200px, which was smaller than the file on disk - a zoom that zoomed less than
 *  the original. The thumbnail is 2x of the 96px rail, and is only built where the rail is
 *  rendered; the body is only rendered where the words are shown. */
const panels = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    preview: await getImage({ src: entry.data.image, width: 2000, format: "webp" }),
    thumbnail: showRail
      ? await getImage({ src: entry.data.image, width: 192, format: "webp" })
      : null,
    Body: prose ? (await render(entry)).Content : null,
  })),
);

const total = panels.length;

/** Only the kinds that actually occur, in registry order - a filter that matches nothing is
 *  a button that lies. This is also how the autumn shoot joins in later: add the files, and
 *  the filter grows by itself. */
const kinds = compositionKinds.filter((kind) => entries.some((entry) => entry.data.kind === kind));

const imageList =
  structuredData && Astro.site
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Obsadzenia z kwiatów Gospodarstwa Ogrodniczego „Saran”",
        itemListElement: panels.map(({ entry, preview }, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "ImageObject",
            "@id": new URL(`/inspiracje/#${entry.id}`, Astro.site).href,
            name: entry.data.title,
            /* The literal description of the frame, not the editorial paragraph: this field
               describes the image, and the prose is in the page body anyway. */
            description: entry.data.imageAlt,
            contentUrl: new URL(preview.src, Astro.site).href,
            representativeOfPage: index === 0,
          },
        })),
      }
    : null;
---

{imageList && <script type="application/ld+json" set:html={JSON.stringify(imageList)} is:inline />}

<section
  class:list={["comp", ground === "dark" && "comp--dark"]}
  data-comp
  aria-labelledby="comp-title"
>
  <div class="comp__head">
    <Heading class="comp__title" id="comp-title">Inspiracje</Heading>
    <p class="comp__lead">
      Kompozycje z kwiatów, które uprawiamy. Kosze, skrzynki, donice i rabaty pokazują różne sposoby
      łączenia roślin, a przy każdej podpowiadamy, jakich kwiatów szukać w ofercie.
    </p>
  </div>

  {
    showFilters && (
      <div class="filters" data-filters>
        <p class="filters__label" id="filters-label">
          Co obsadzasz
        </p>
        <div class="filters__row" role="group" aria-labelledby="filters-label">
          <button type="button" data-filter="all" aria-pressed="true">
            Wszystkie
          </button>
          {kinds.map((kind) => (
            <button type="button" data-filter={kind} aria-pressed="false">
              {kind}
            </button>
          ))}
        </div>
      </div>
    )
  }

  <div class="controls" data-controls>
    <button type="button" data-prev aria-controls="comp-track">Poprzednie</button>
    <p class="counter" role="status">
      <span data-index>1</span> z <span data-total>{total}</span>
    </p>
    <button type="button" data-next aria-controls="comp-track">Następne</button>
    <button type="button" data-toggle aria-pressed="false">Zatrzymaj</button>
  </div>

  <p id="comp-hint" class="sr-only">
    Przewijaj w poziomie albo używaj strzałek w lewo i w prawo. Obsadzeń jest {total}.
  </p>

  <ul
    id="comp-track"
    class="track"
    data-track
    tabindex="0"
    role="list"
    aria-roledescription="pokaz obsadzeń"
    aria-label="Obsadzenia z naszych kwiatów"
    aria-describedby="comp-hint"
  >
    {
      panels.map(({ entry, preview, Body }, index) => {
        const { data } = entry;
        return (
          <li class="panel" id={ids ? entry.id : undefined} data-panel data-kind={data.kind}>
            <figure class="panel__figure">
              <a
                class="panel__link"
                href={preview.src}
                data-lightbox
                aria-label={`Powiększ: ${data.imageAlt}`}
              >
                <Picture
                  src={data.image}
                  formats={["avif", "webp"]}
                  fallbackFormat="jpg"
                  widths={[560, 1120]}
                  sizes="(min-width: 900px) 520px, 88vw"
                  width={480}
                  height={640}
                  alt={data.imageAlt}
                  loading={level === 1 && index === 0 ? "eager" : "lazy"}
                />
              </a>

              <figcaption class="panel__meta">
                <p class="panel__kind">
                  {data.kind} · <span>{index + 1}</span> z {total}
                </p>
                <PanelHeading class="panel__name">
                  {/* On the home page the strip is a preview, so its heading is the way in to
                      the planting's own address rather than a dead end. */}
                  {level === 1 ? data.title : <a href={`/inspiracje/#${entry.id}`}>{data.title}</a>}
                </PanelHeading>

                {Body && (
                  <div class="panel__desc">
                    <Body />
                  </div>
                )}

                {data.plants.length > 0 && (
                  <div class="panel__plants">
                    <p class="panel__plantsLabel">Kwiaty w tym obsadzeniu</p>
                    <ul class="chips">
                      {data.plants.map((slug) => {
                        const plant = plantLinks[slug];
                        /* What the name alone will not tell a reader, and whether we sell it
                           at all - see `plant-links.ts`. */
                        const notes = [plant.qualifier, plant.companion ? "dodatek" : null].filter(
                          (note): note is string => note !== null && note !== undefined,
                        );
                        return (
                          <li>
                            {plant.href ? (
                              <a class="chip" href={plant.href}>
                                {plant.label}
                                {notes.map((note) => (
                                  <span class="chip__note">· {note}</span>
                                ))}
                              </a>
                            ) : (
                              <span class="chip chip--flat">
                                {plant.label}
                                {notes.map((note) => (
                                  <span class="chip__note">· {note}</span>
                                ))}
                              </span>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}

                {prose && (
                  <div class="panel__tip">
                    <p class="panel__tipLabel">Nasza podpowiedź</p>
                    <p class="panel__tipBody">{data.tip}</p>
                  </div>
                )}

                <div class="panel__actions">
                  {/* The phone belongs to `/inspiracje/`, where a visitor who has just found a
                      basket they like should not have to go looking for it. It must **not**
                      appear in the reduced variant: 23 panels on the home page would print
                      `602 518 401` twenty-three times, and with the Intro and the footer that
                      is 25 times on the entrance page - the defect version 0.6 deleted
                      `ContactStrip` to fix, eight times over. The way to the phone from here
                      is the link beside it, one click away. */}
                  {level === 1 && (
                    <a class="cta" href={primaryPhone.href}>
                      Zapytaj: {primaryPhone.display}
                    </a>
                  )}
                  <a class="cta-line" href="/kontakt/">
                    Kontakt i dojazd
                  </a>
                </div>
              </figcaption>
            </figure>
          </li>
        );
      })
    }
  </ul>

  {
    allLink && (
      <p class="comp__all">
        <a class="cta-line" href="/inspiracje/">
          Zobacz wszystkie obsadzenia
        </a>
      </p>
    )
  }

  {
    showRail && (
      <nav class="rail" data-rail aria-label="Wszystkie obsadzenia">
        <p class="rail__label" id="rail-label">
          Wszystkie obsadzenia
        </p>
        <ul aria-labelledby="rail-label">
          {panels.map(({ entry, thumbnail }, index) => (
            <li data-thumb-item>
              {/* An anchor, not a button: without JavaScript it still jumps to the panel. */}
              <a
                class="thumb"
                href={`#${entry.id}`}
                data-thumb
                data-kind={entry.data.kind}
                aria-current={index === 0 ? "true" : undefined}
              >
                <img
                  src={thumbnail!.src}
                  alt={entry.data.title}
                  width="96"
                  height="128"
                  loading="lazy"
                />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</section>
<style>
  .comp {
    border-top: 1px solid var(--rule);
    padding: var(--pad-section) var(--edge);
    display: grid;
    gap: 1.25rem;
  }

  /* ---------- the green band (home page only) ---------- */

  /* Unlike `.history` and `.footer`, which name their dark colours rule by rule, this block
     remaps the tokens and lets every rule below it keep the name it already used. That is a
     deliberate difference and it is about size: those two blocks hold five elements each,
     this one holds a heading, a lead, a strip, controls, captions and chips across ~250 lines
     of CSS, and a second copy of all of it would rot the moment either copy was edited.
     Custom properties inherit, so one block turns the whole section over - the same mechanism
     the project already uses for --focus-ring, applied to the rest of the palette.

     The band took three tries: --green-deep ("too dark"), a much lighter #556848 ("not the
     right colour"), and this one - darker than both, picked off a side-by-side comparison. See that token for what this ground gives
     back - on it every text colour clears AA with room, which the light version did not.

     **--green-band must not be remapped here.** It is the ground of this band, so
     `background: var(--green-band)` on this very element would resolve through its own
     remapping and the element would paint itself in whatever the token had been pointed at.
     --green-deep is free for exactly that reason - it is no longer the ground - but on a band
     this dark it is no longer *usable* as a fill either, which is what the inversion below is
     for. */
  .comp--dark {
    background: var(--green-band);
    /* The colour change is the edge; a rule on top of it would draw a seam. */
    border-top-color: var(--green-band);
    /* Set explicitly, and this is the one thing the token remapping below cannot do for it.
       `color` is inherited: by the time it reaches this section it has already been resolved
       on `body` from the page-level --ink, so pointing --ink somewhere else here changes
       nothing for any element that does not name a colour of its own. The heading was dark
       green on dark green until this line existed. */
    color: var(--bone);

    --ink: var(--bone);
    --ink-soft: var(--green-body);
    --ink-grey: var(--green-lit);
    --green: var(--green-lit);
    /* Latent: nothing in this band is an overline today. It is remapped anyway so that adding
       one is a one-line change rather than a contrast investigation - 6.47:1 here. */
    --ochre: var(--ochre-lit);
    /* The chip loses its plate and keeps its border. --green-slot, which fills it everywhere
       else, is 1.09:1 against this ground: a background nobody can see, drawn anyway. An
       outline is what the controls beside it already use, so the band gains consistency
       rather than losing a shape. */
    --paper-dim: transparent;
    --rule: rgb(238 240 230 / 22%);
    --rule-dim: rgb(238 240 230 / 30%);
    --rule-link: rgb(238 240 230 / 35%);
    /* Dark ground: the default ring is 1.67:1 here. See tokens.css. */
    --focus-ring: var(--green-lit);
  }

  /* The pair "fill with --green-deep, write in --paper" appears four times below. Against this
     ground that fill is 1.27:1 - a pressed button indistinguishable from the band it sits on -
     so the pair is inverted rather than recoloured: a light fill with dark type, 6.02:1 either
     way round. */
  .comp--dark
    :is(
      .filters button:hover,
      .filters button[aria-pressed="true"],
      .controls button:hover,
      a.chip:hover
    ) {
    color: var(--green-deep);
    background: var(--green-lit);
    border-color: var(--green-lit);
  }

  .comp--dark .thumb[aria-current="true"] {
    border-color: var(--green-lit);
  }

  .comp__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.9rem;
  }

  .comp__title {
    font-size: var(--text-h2);
  }

  .comp__lead {
    max-width: 52ch;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- filters ---------- */

  /* The filter only works with a script, so it only exists with one. Gated on `html.js`
     rather than [hidden], because an author `display` beats the browser's rule for it. */
  .filters {
    display: none;
  }
  :global(html.js) .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }

  .filters__label {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }

  .filters__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filters button {
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    background: none;
    border: 1px solid var(--rule-dim);
    padding-inline: 1.1rem;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .filters button:hover {
    color: var(--paper);
    background: var(--green-deep);
    border-color: var(--green-deep);
  }
  .filters button[aria-pressed="true"] {
    color: var(--paper);
    background: var(--green-deep);
    border-color: var(--green-deep);
  }

  /* ---------- controls ---------- */

  .controls {
    display: none;
  }
  :global(html.js) .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
  }

  .controls button {
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    background: none;
    border: 1px solid var(--rule-dim);
    padding-inline: 1.1rem;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .controls button:hover {
    color: var(--paper);
    background: var(--green-deep);
    border-color: var(--green-deep);
  }
  /* The `display: inline-flex` above is an author style and would otherwise beat the
     browser's rule for [hidden] - the script hides the play control under reduced motion. */
  .controls button[hidden] {
    display: none;
  }

  .counter {
    font-size: 0.85rem;
    color: var(--ink-grey);
    font-variant-numeric: tabular-nums;
    min-width: 6ch;
    text-align: center;
  }

  /* ---------- the strip ---------- */

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding-inline: max(0px, (100% - 980px) / 2);
    list-style: none;
    overscroll-behavior-x: contain;
  }

  /* The scrollbar is the only affordance a visitor without JavaScript has, so it stays
     visible for them and goes away once the buttons exist. */
  :global(html.js) .track {
    scrollbar-width: none;
  }
  :global(html.js) .track::-webkit-scrollbar {
    display: none;
  }

  /* **The width is the track's, not the viewport's, and that is the whole point.** It used to
     be `min(92vw, 980px)`: on a phone that is 92% of the *viewport*, while the track is the
     viewport minus `--edge` on both sides, so every panel was about 9px wider than the box it
     scrolls in. With `scroll-snap-align: center` the browser then centred that oversized panel
     and it overhung by half of the difference at each end - which clipped the overline and the
     title on the left of every panel after the first. The first looked fine only because a
     scrollport cannot scroll past its own start, so panel one sat flush left and spilled to
     the right alone. `100%` resolves against the track's content box, so a panel now fits it
     exactly at every width; on a desk the track's `padding-inline` caps that box at 980px, so
     nothing about the wide layout changes. */
  .panel {
    flex: 0 0 min(100%, 980px);
    scroll-snap-align: center;
    /* Anchors land under nothing - the masthead does not stick - but a jump to a panel
       should not put it flush against the viewport edge. */
    scroll-margin-inline: 1rem;
  }
  .panel[hidden] {
    display: none;
  }

  /* One photograph and its facts, side by side on a desk and stacked on a phone - without a
     breakpoint deciding which. `auto-fit` measures the panel, which is a fixed flex item. */
  .panel__figure {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1.25rem var(--gap-columns);
    align-items: start;
  }

  .panel__link {
    display: block;
    justify-self: start;
    max-height: min(62vh, 620px);
  }

  .panel__link :global(img) {
    display: block;
    max-height: min(62vh, 620px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border: 1px solid var(--rule);
  }
  .panel__link:hover :global(img) {
    border-color: var(--green);
  }

  .panel__meta {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    max-width: 46ch;
  }

  .panel__kind {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
    font-variant-numeric: tabular-nums;
  }

  .panel__name {
    font-size: var(--text-h3);
  }

  /* In the home page variant the heading is a link to the planting on `/inspiracje/`. It
     keeps the heading's colour and takes the same understated rule the plant links have,
     rather than announcing itself as a second call to action. */
  .panel__name a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule-link);
  }
  .panel__name a:hover {
    color: var(--green);
    border-bottom-color: var(--green);
  }

  /* The editorial description, straight out of the planting's Markdown body - so it is a
     block of paragraphs now, not the one literal sentence the `alt` used to supply. */
  .panel__desc {
    display: grid;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .panel__plants {
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
    display: grid;
    gap: 0.5rem;
  }

  .panel__plantsLabel {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .chip {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper-dim);
    border: 1px solid var(--rule-dim);
    padding-inline: 0.85rem;
