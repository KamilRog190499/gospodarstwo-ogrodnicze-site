---
import MapEmbed from "./MapEmbed.astro";
import { address, postalCity } from "../data/contact";

/**
 * "Jak do nas trafić" - the map on the home page.
 *
 * ## Why this is not `ContactStrip` coming back
 *
 * Version 0.5 had a contact band in this position and 0.6 removed it, for a reason worth
 * repeating so nobody removes this block for the same one: the strip printed the address,
 * one phone number and "Wyznacz trasę" directly above a footer printing the address, all
 * four phone numbers and the same link. `602 518 401` appeared three times on one page.
 *
 * **This block carries no phone number at all.** It answers one question the footer does not
 * - *where is this and how do I get there* - with the thing only a map can be, and sends
 * anyone who wants to call to `/kontakt/`. The address is repeated, deliberately: an address
 * beside a map is what makes the map readable, and it is the one fact a visitor copies.
 *
 * The map itself is `MapEmbed`, unchanged and unwrapped. It is consent-gated, so nothing
 * reaches Google from the home page either until the visitor agrees; `consent.ts` already
 * fills in every `[data-map]` on the page, and the answer is remembered across the site, so
 * accepting here means the map on `/kontakt/` is already allowed. "Wyznacz trasę" lives
 * inside `MapEmbed` and works without consent.
 *
 * The section id is `dojazd`, not `kontakt` - `Contact.astro` owns that one.
 */
---

<section id="dojazd" class="directions" aria-labelledby="dojazd-title">
  <div class="directions__where">
    <h2 class="directions__title" id="dojazd-title">Jak do nas trafić</h2>
    <p class="directions__lead">
      Jesteśmy w Cholewiance pod Kazimierzem Dolnym. Kwiaty oglądasz i kupujesz na miejscu, w
      tunelach - zapraszamy.
    </p>
    <p class="directions__address">
      {address.street}<br />{postalCity}<br />{address.region}
    </p>
    <p>
      <a class="cta-line" href="/kontakt/">Telefony i kontakt</a>
    </p>
  </div>

  <MapEmbed />
</section>

<style>
  /* The same two-column formula as `Contact.astro` - `auto-fit` at 300px, no breakpoint. */
  /* The third dark plate on the home page, and the only one that has a child component inside
     it - MapEmbed. That is why this block remaps the tokens rather than naming colours rule by
     rule: custom properties inherit into a scoped child, a list of overrides does not.
     **--green-band must not be remapped**, it is the ground; see Compositions.astro for what
     happens when a block repaints itself through its own remapping. */
  .directions {
    border-top: 1px solid var(--rule);
    background: var(--green-band);
    color: var(--bone);

    --ink: var(--bone);
    --ink-soft: var(--green-body);
    --ink-grey: var(--green-lit);
    --green: var(--green-lit);
    --ochre: var(--ochre-lit);
    /* The map placeholder loses its fill and keeps its hatching, which is drawn in a light
       colour and reads on the plate. A --paper-dim panel here would be 1.05:1. */
    --paper-dim: transparent;
    --rule: rgb(238 240 230 / 22%);
    --rule-dim: rgb(238 240 230 / 30%);
    --focus-ring: var(--green-lit);

    padding: var(--pad-section-wide) var(--edge);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--gap-columns);
    align-items: start;
  }

  .directions__where {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .directions__title {
    font-size: var(--text-h2);
  }

  .directions__lead {
    max-width: 46ch;
    color: var(--ink-soft);
  }

  /* The address in the serif, at the size the phone numbers take on `/kontakt/` - it is the
     fact this block exists to state. */
  .directions__address {
    font-family: var(--serif);
    font-size: var(--text-tel);
    line-height: 1.3;
  }

  /* The consent button fills with --green-deep and writes in --paper. On this plate that fill
     is 1.27:1 - a button you cannot see - so the pair is inverted here, 7.63:1 either way
     round. Reached with :global() because the button belongs to MapEmbed. */
  /* MapEmbed hatches its placeholder with a light stripe at 80% alpha. On paper that is a
     faint tint; on this plate it is a barcode - the same rule, a completely different reading,
     because the stripe was picked against a cream ground. Redrawn here at a tenth of the
     weight. */
  .directions :global(.map__frame) {
    background-image: repeating-linear-gradient(
      100deg,
      rgb(238 240 230 / 10%) 0 12px,
      rgb(238 240 230 / 0%) 12px 24px
    );
  }

  .directions :global(.map__ask button) {
    color: var(--green-band);
    background: var(--green-lit);
  }
  .directions :global(.map__ask button:hover) {
    background: var(--bone);
  }
</style>
