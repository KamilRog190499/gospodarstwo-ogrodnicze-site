---
import { Picture } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import PhotoSlot from "./PhotoSlot.astro";

/**
 * One plant in the offer: photograph on the left, everything we know about it on the right.
 *
 * This is the pattern carried over from the current site and the reason people find it in
 * search - a long, concrete cultivation description under the plant's name. The text is the
 * owners' own; it is not shortened here or anywhere else.
 *
 * Two things changed with the move to real category pages:
 *
 * - the heading level is a prop. On a category page the plant sits directly under the
 *   page's `h1`, so it is an `h2`; the level is passed in rather than hardcoded, because a
 *   heading that is right in one place and wrong in another is the defect this had before.
 * - the group chip is off by default. On `/kwiaty-balkonowe/` every entry is balkonowe;
 *   the chip repeated the page's own title once per plant. It stays available for a mixed
 *   listing (search results, a future "wszystkie rośliny" page).
 *
 * The photograph is the entry's own when it has one. `image` and `imageAlt` come from the
 * frontmatter and the schema keeps them together, so the branch is on the pair, not on one
 * of them; an entry without a photograph falls back to the striped `PhotoSlot`, which is now
 * a waiting state rather than the default. Three of the sixteen plants are photographed so
 * far, so both arms of this render on the live site and both have to keep working.
 *
 * The file name is the anchor, so /kwiaty-balkonowe/#fuksja links straight at one plant.
 */
interface Props {
  entry: CollectionEntry<"plants">;
  /** Heading level for the plant's name. 2 under a page `h1`. */
  level?: 2 | 3 | 4;
  /** Show the group chip - only where the listing mixes groups. */
  showGroup?: boolean;
  /** The first entry on a category page: its photograph is the likely LCP element, so it
   *  is fetched eagerly instead of being pushed behind the lazy queue. */
  priority?: boolean;
  /** Show a "wróć do spisu" link back to the category page's `#offer-title` - only where
   *  `OfferSection` also rendered its spis (more than one entry in the group), otherwise
   *  there is nothing at the top worth returning to. */
  backToIndex?: boolean;
}

const { entry, level = 2, showGroup = false, priority = false, backToIndex = false } = Astro.props;
const { name, group, slot, image, imageAlt, facts, colors } = entry.data;
const { Content } = await render(entry);

/**
 * The frame follows the photograph instead of forcing one ratio on all of them.
 *
 * The handoff asks for 4:3 per plant (docs/design/README.md), but eleven of the fourteen
 * photographs the owners supplied are portrait and four of those are 9:16 phone frames. A 4:3
 * window kept only 41-61% of them and took that band from the middle, so on alstromeria,
 * fuksja and niecierpek - where the bloom is simply taller than the window - it clipped the
 * petals at the frame edge. **`object-position` cannot fix that**: aiming moves the band, and
 * no position helps when the subject does not fit in it. Only a taller box does.
 *
 * So the box is the file's own ratio, capped at 3:4: nothing is cropped unless the photograph
 * is taller than that, and then `object-fit: cover` takes the middle. The four phone frames go
 * from 41% to 73% and every other photograph is shown whole. A 4:3 file still lands in a 4:3
 * box untouched, which is why `PhotoSlot` beside it keeps asking for 4:3.
 *
 * Chosen by the owner in September 2026 over a flat 3:4 and a flat 1:1, both of which fixed
 * the portrait frames by breaking the three landscape ones. docs/inwentaryzacja.md has the
 * measurements.
 */
const PHOTO_MIN_RATIO = 3 / 4;
const photoRatio = image ? Math.max(image.width / image.height, PHOTO_MIN_RATIO) : null;

/** `width`/`height` describe the **box**, not the file - otherwise the browser reserves the
 *  file's height and the text under the photograph jumps when it loads. */
const PHOTO_WIDTH = 560;

const Heading = `h${level}` as "h2" | "h3" | "h4";
---

<article class="entry" id={entry.id}>
  <figure class="entry__figure">
    {
      image && imageAlt ? (
        <Picture
          class="entry__photo"
          src={image}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          widths={[560, 1120]}
          sizes="(min-width: 1200px) 578px, (min-width: 700px) 45vw, 90vw"
          width={PHOTO_WIDTH}
          height={Math.round(PHOTO_WIDTH / photoRatio!)}
          style={`--entry-ratio: ${photoRatio}`}
          alt={imageAlt}
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : undefined}
        />
      ) : (
        <PhotoSlot ratio="4 / 3" label={slot} stripe={10} boxed />
      )
    }
  </figure>

  <div class="entry__text">
    <div class="entry__head">
      <Heading class="entry__name">{name}</Heading>
      {showGroup && <span class="entry__group">{group}</span>}
    </div>

    <div class="entry__body copy">
      <Content />
    </div>

    {
      facts && (
        <dl class="facts">
          {facts.map((fact) => (
            <div class="facts__item">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      colors && (
        <div class="colors">
          <p class="colors__label">Dostępne kolory</p>
          <ul class="colors__list">
            {colors.map((colour) => (
              <li>{colour}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      backToIndex && (
        <p class="entry__back">
          <a class="cta-line" href="#offer-title">
            Wróć do spisu roślin
          </a>
        </p>
      )
    }
  </div>
</article>

<style>
  /* **The only rule inside an entry, and that is what makes it readable.** The handoff draws
     this separator and the one above `.facts` identically (1px `#E0DDCE`). In two columns that
     works, because the facts rule spans the text column while this one spans the page. In one
     column they collapse onto the same width and become the same mark, and the reader cannot
     tell "the facts follow" from "a different plant starts here" - which the owners reported.
     There is no breakpoint to fix it in, so one of the two had to go, and the one that carries
     less meaning went: see `.facts`. A line on a category page now says exactly one thing.
     Thickening this one instead was tried and rejected - a 2px rule is a mark this design does
     not otherwise make on a page. */
  .entry {
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(1.75rem, 4vw, 3rem);
    display: grid;
    gap: var(--gap-entry);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    /* Without this the photograph stretches to the height of the text beside it. */
    align-items: start;
  }

  .entry__figure {
    display: grid;
    gap: 0.6rem;
  }

  /* The ratio comes from `--entry-ratio` on the element - the photograph's own, capped at 3:4;
     the note beside `PHOTO_MIN_RATIO` above argues why. The fallback is the 4:3 the placeholder
     holds, which is what an entry renders at if the custom property ever fails to land.
     `object-fit: cover` only bites on the four frames taller than 3:4; for every other
     photograph the box already matches the file and it crops nothing. The entries stack as
     rows rather than sitting in a grid, so they do not have to share a height. 578px in
     `sizes` is the photograph column at full width: --edge caps the content at 1200px, .entry
     splits it in two, and --gap-entry takes at most 2.75rem out of the middle. */
  .entry__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--entry-ratio, 4 / 3);
    object-fit: cover;
    border: 1px solid var(--rule);
  }

  .entry__text {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  /* Baseline, not centre: the serif name and the uppercase chip have very different
     cap heights, and centring them makes the chip look like it is falling. */
  .entry__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
  }

  /* The size is on the class, not the tag, so the heading level can change without the
     type changing with it. */
  .entry__name {
    font-size: var(--text-h3);
    line-height: 1.1;
  }

  .entry__group {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    background: var(--paper-dim);
    border: 1px solid var(--rule-dim);
    padding: 0.2rem 0.5rem;
    white-space: nowrap;
  }

  .entry__body {
    max-width: 60ch;
    color: var(--ink-soft);
  }

  /* **Space, not a line** - a departure from the handoff, which gives this block
     `border-top: 1px solid #E0DDCE` and `padding-top: 0.85rem` (docs/design/README.md). The
     rule is what collided with the entry separator once the columns stacked; the block loses
     nothing by it, because the uppercase `dt` labels already announce that a different kind of
     content starts here. The padding grows to carry the separation the line used to. Chosen by
     the owner in September 2026 from a mock-up of four alternatives; docs/inwentaryzacja.md
     records what the other three were and why this one won. */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 0.75rem 1.5rem;
    padding-top: 1.4rem;
  }

  /* `start`, not the default stretch: the item box is stretched to the tallest fact in the
     row, and stretched auto rows push the value away from its label - so a two-line value
     next to a one-line one left the two `dd`s on different lines. */
  .facts__item {
    display: grid;
    align-content: start;
    gap: 0.1rem;
  }

  .facts dt {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }

  .facts dd {
    font-size: 0.95rem;
    margin: 0;
  }

  .colors {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.15rem;
  }

  .colors__label {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }

  .colors__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .colors__list li {
    font-size: 0.85rem;
    border: 1px solid var(--rule-dim);
    background: var(--paper-dim);
    padding: 0.25rem 0.65rem;
  }

  .entry__back {
    margin-top: 0.4rem;
  }
</style>
