---
import { Picture } from "astro:assets";
import type { GalleryPhoto } from "../data/gallery";

/**
 * A row of photographs that belong to the page as a whole rather than to one entry.
 *
 * `/chryzantemy/` uses it under the plant list: the three entries show what each type's
 * flower looks like, and this shows the offer - the colours, the scale, the rows. The
 * pictures are mixed plantings, so nothing here claims to be one type; that distinction is
 * the whole reason the strip exists instead of more entry photographs.
 *
 * The label is a `<p>`, not a heading, and deliberately so: the page outline is `h1` then one
 * `h2` per plant, and a heading here would put a row of pictures on the same level as a
 * plant. It follows the same uppercase-overline pattern as "Pozostałe grupy".
 *
 * No lightbox and no carousel - it is a static row. The slideshow on `/inspiracje/` is the
 * one sanctioned exception to "nie dodawaj karuzel" and this is not a second one.
 *
 * `widths` tops out at 720 because the chrysanthemum sources are 736px wide - anything more
 * would be an upscale. See the note on `chrysanthemumStrip` in src/data/gallery.ts.
 */
interface Props {
  photos: GalleryPhoto[];
  /** The uppercase overline above the row. */
  label: string;
}

const { photos, label } = Astro.props;
---

<section class="strip" aria-label={label}>
  <p class="strip__label">{label}</p>
  <ul class="strip__grid">
    {
      photos.map((photo) => (
        <li>
          <Picture
            class="strip__photo"
            src={photo.src}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[360, 720]}
            sizes="(min-width: 1200px) 285px, (min-width: 640px) 30vw, 45vw"
            width={360}
            height={480}
            alt={photo.alt}
            loading="lazy"
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .strip {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--rule);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.9rem;
  }

  .strip__label {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }

  /* Four portrait frames across a full-width row, folding to two and then one as the
     column would drop under 200px. No breakpoint decides that. */
  .strip__grid {
    display: grid;
    gap: var(--gap-cards);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  /* The sources are 3:4; the frame keeps that ratio so nothing is cropped, and takes the
     same 1px rule every other photograph on the site has. */
  .strip__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--rule);
  }
</style>
