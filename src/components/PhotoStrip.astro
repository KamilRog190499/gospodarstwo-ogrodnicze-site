---
import { Picture, getImage } from "astro:assets";
import type { GalleryPhoto } from "../data/gallery";

/**
 * A row of photographs that belong to the page as a whole rather than to one entry.
 *
 * `/chryzantemy/` uses it under the plant list: the entries show what each type's flower looks
 * like, and this shows the offer - the colours, the scale, the rows, and at the end a finished
 * pot. Nothing here claims to be one type; that distinction is the whole reason the strip
 * exists instead of more entry photographs.
 *
 * The label is a `<p>`, not a heading, and deliberately so: the page outline is `h1` then one
 * `h2` per plant, and a heading here would put a row of pictures on the same level as a
 * plant. It follows the same uppercase-overline pattern as "Pozostałe grupy".
 *
 * **Still no carousel** - it is a static row, and the slideshow on `/inspiracje/` remains the
 * one sanctioned exception to "nie dodawaj karuzel".
 *
 * **It does have a lightbox now**, asked for by the owner in September 2026; this comment used
 * to say it did not. The reason it can is the reason it had to: the frame is a fixed 3:4 and
 * `object-fit: cover`, so a source that is not 3:4 is cropped on the page, and four of the
 * nineteen chrysanthemum frames are not. Without a way to open the whole picture, the crop was
 * the only thing a visitor could ever see. It reuses `src/scripts/lightbox.ts` exactly as the
 * slideshow does: an `<a>` around the thumbnail whose `href` is the full frame, so with
 * scripting off the link still opens the photograph on its own. Nothing is built per page -
 * the overlay is created once, lazily, by the global script.
 *
 * **The section carries `id="zdjecia"`**, because the home page show links into it: its
 * "Więcej zdjęć" row points at `/kwiaty-balkonowe/#zdjecia` rather than at the top of the page,
 * so a visitor who came for photographs lands on the photographs. Like every other section id
 * here the fragment is Polish, because it is a published address.
 *
 * The lightbox target is the source at its own size, capped at 2000px: `offer-01..04` are only
 * 736px wide, and asking for 2000 would hand the visitor an upscale of a small file.
 *
 * `widths` tops out at 720 because that is what the frame can use - 285px at the 1200px cap,
 * doubled for a dense screen. The newer sources are 1500px+, so this is now a choice rather
 * than a limit. See the note on `chrysanthemumStrip` in src/data/gallery.ts.
 */
interface Props {
  photos: GalleryPhoto[];
  /** The uppercase overline above the row. */
  label: string;
}

const { photos, label } = Astro.props;

/** One full-size target per frame, resolved at build time. `withoutEnlargement` is not a
 *  `getImage` option, so the cap is applied here instead. */
const previews = await Promise.all(
  photos.map((photo) =>
    getImage({ src: photo.src, width: Math.min(2000, photo.src.width), format: "webp" }),
  ),
);
---

<section class="strip" id="zdjecia" aria-label={label} data-lightbox-group>
  <p class="strip__label">{label}</p>
  <ul class="strip__grid">
    {
      photos.map((photo, index) => (
        <li>
          <a
            class="strip__link"
            href={previews[index].src}
            data-lightbox
            aria-label={`Powiększ: ${photo.alt}`}
          >
            <Picture
              class="strip__photo"
              src={photo.src}
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              widths={[360, 720]}
              sizes="(min-width: 1200px) 285px, (min-width: 640px) 30vw, 45vw"
              width={360}
              height={480}
              alt={photo.alt}
              loading="lazy"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .strip {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--rule);
    padding-top: 1.1rem;
    display: grid;
    gap: 0.9rem;
  }

  .strip__label {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }

  /* Four portrait frames across a full-width row, folding to three and then two as the
     column would drop under the floor. No breakpoint decides that.

     **The floor is a clamp rather than a flat 200px, and the phone is why.** At 200px a phone
     never got two columns - 2x200 plus the 32px `--gap-cards` needs 432px of content and the
     widest phone offers about 390 - so every strip stood in **one** column: 24 frames measured
     10 496px on `/kwiaty-balkonowe/` and 20 frames were 8 741px of the 14 240px page on
     `/chryzantemy/`, which is 61% of a category page spent on one vertical wall of photographs.
     The `sizes` attribute above was written for the two columns nobody was getting, so the
     browser sized each frame at 45vw (162px at 360px, 324px at DPR 2), picked the 360w file and
     drew it into a 305px box - a 1.7x upscale, on every photograph, on every phone.

     The clamp gives the floor back its width where there is width to give. 30vw reaches the
     200px ceiling at a 667px viewport, so **from there up nothing moves at all** - the tablet
     still folds three across and the 1200px band still holds four. Below it the floor shrinks
     with the screen and settles on its 120px minimum around 400px, which is what buys the second
     column: 2x120 plus the gap needs 272px and a 320px phone offers 280px of content. Checked
     across the range rather than at the ends - 320, 360, 400, 450, 500, 600 and 667 all give two,
     768 gives three, 1200 gives four.

     Neither end of the clamp is arbitrary. A flat 140px floor leaves the narrowest phones in one
     column again; a flat 120px one lets a third column onto a 500px screen, where the frames come
     out 129px wide. And a flat 120px on the wide end would put a fifth column on the 1200px band. */
  .strip__grid {
    display: grid;
    gap: var(--gap-cards);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, clamp(120px, 30vw, 200px)), 1fr));
  }

  /* The link is the frame: block-level so the 1px rule below sits where the photograph does,
     and so the focus ring drawn by the global :focus-visible rule wraps the picture rather
     than a zero-height inline box. */
  .strip__link {
    display: block;
  }

  /* Most sources are 3:4 and the frame keeps that ratio, so nothing is cropped; the four that
     are not (see `chrysanthemumStrip`) lose their edges to `cover`, and the lightbox is where
     the whole frame lives. The 1px rule is the one every other photograph on the site has. */
  .strip__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--rule);
  }

  /* The same acknowledgement the offer tiles make: the frame is a control, so it answers the
     pointer. No transform and no shadow - this design has neither. */
  .strip__link:hover .strip__photo {
    border-color: var(--green);
  }
</style>
