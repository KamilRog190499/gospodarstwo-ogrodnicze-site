---
/**
 * Meta tags for a single page.
 *
 * `title` and `description` deliberately have no defaults: a missing description should be
 * a type error at build time, not a silent gap in search results.
 *
 * `ogImage` has no default here either, but it no longer goes unset: `BaseLayout.astro`
 * crops one to 1200x630 for every page and passes it down. The optional shape stays because
 * this component should still render something sane if it is ever used on its own - a page
 * without an image simply emits no `og:*` image tags.
 */
interface Props {
  title: string;
  description: string;
  /** Page path, e.g. "/". Turned into a full canonical URL. */
  canonical: string;
  /** Site-root path to a 1200x630 image - either a file in /public or, as `BaseLayout`
   *  passes it, the `src` of one Astro has already processed. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Keeps the page out of search indexes and drops the canonical link. Used by 404,
   *  which is served at every address that does not exist. */
  noindex?: boolean;
}

const OG_WIDTH = 1200;
const OG_HEIGHT = 630;

const {
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt,
  ogType = "website",
  noindex = false,
} = Astro.props;

if (!Astro.site) {
  throw new Error("No `site` in astro.config.mjs - canonical URLs cannot be built without it.");
}

const canonicalUrl = new URL(canonical, Astro.site).href;
const imageUrl = ogImage ? new URL(ogImage, Astro.site).href : null;

const siteName = "Gospodarstwo Ogrodnicze „Saran”";

/* The suffix every page title gets, and it is deliberately not `siteName`.
 *
 * Google shows about 60 characters of a title. The formal name spends 34 of them, which left
 * no room for the one word that earns a local business its clicks: the town. "Kwiaty
 * balkonowe" ranked against "kwiaty balkonowe kazimierz dolny" with the locality nowhere in
 * the title at all. This form costs 27 and fits the town on every page - the longest title on
 * the site is now 57 characters.
 *
 * What is given up is the word "Gospodarstwo Ogrodnicze" in the search result, and only
 * there. The formal name is untouched in the masthead, in `og:site_name` below, and in the
 * JSON-LD `name` - which is the string search engines read as the entity's name. */
const titleSuffix = "„Saran”, Kazimierz Dolny";

/* A page whose own title already names the business skips the suffix, so it can write the
   whole thing itself rather than stutter. The home page is the only one that does. */
const fullTitle = title.includes("Saran") ? title : `${title} - ${titleSuffix}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <link rel="canonical" href={canonicalUrl} />
  )
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="pl_PL" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
{
  imageUrl && (
    <>
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:width" content={String(OG_WIDTH)} />
      <meta property="og:image:height" content={String(OG_HEIGHT)} />
      {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={imageUrl} />
    </>
  )
}
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
