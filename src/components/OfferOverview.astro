---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import { offer, plantCount, type PlantGroup } from "../data/offer";
import { chrysanthemumStrip, pansyStrip, type GalleryPhoto } from "../data/gallery";

/**
 * The offer on the home page: one card per category page, each opening with two of that
 * group's own photographs.
 *
 * This is what replaced the flat list of fourteen plants that used to sit here. The home
 * page's job is to say what the holding sells and send people to the right page; the
 * descriptions are the plant names themselves, taken from the collection, so nothing here
 * is copy that has to be kept in step with the offer by hand.
 *
 * The four pages come from `src/data/offer.ts` and no longer from a list in this file - the
 * same four addresses used to be written out both here and in `navigation.ts`.
 *
 * **Nothing here says what month it is.** For one release the "W trakcie" marker lived on
 * these tiles; it belongs to `SeasonCards`, which is the block whose subject is the year.
 * Four equal doors to four pages is what this block is for, and a door that changes colour
 * with the date is a worse door.
 *
 * ## The mosaic: two frames, always
 *
 * **The count is fixed at two, and that is the whole design.** It was "up to three, whatever
 * the collection happens to hold", and every problem this block has had came from that
 * number moving: with the ratio on each frame, the pansy tile - one plant, one photograph -
 * had a strip three times taller than the tile holding eleven, so the smallest group was the
 * heaviest thing in the section. Moving the ratio onto the strip levelled the heights and
 * broke the frames instead: three came out nearly square, two came out as 110x57 letterboxes
 * on `Rabatowe i wieloletnie`.
 *
 * Two frames at 4:3 in two fixed columns has neither failure, because there is no longer a
 * variable to fail on. Every tile is the same height and every frame is the same shape, and
 * at ~110x82 they are bigger than the three ~70x53 slivers they replace.
 *
 * Two is also the number the content can actually guarantee. `Rabatowe` has exactly two
 * entries with a photograph and no `PhotoStrip` to borrow from, so it can never reach three;
 * a design needing three would be permanently broken on one of the four tiles.
 *
 * Which two: **the collection chooses, not a list here.** The group's entries in `order` that
 * have an `image`, then, if that is fewer than two, the group's own `PhotoStrip` - the same
 * frames that sit under the list on its page. The day dahlia, pelargonia bluszczolistna or
 * sundaville gets a photograph it joins the queue by itself.
 *
 * The frames are decorative - `alt=""` - and that is deliberate rather than lazy. The whole
 * card is one link (see below); its accessible name is the text inside it, which already
 * names every plant in the mosaic. Repeating `imageAlt` here would make a screen reader read
 * two long sentences before the name of the group they belong to.
 */
const plants = (await getCollection("plants")).sort((a, b) => a.data.order - b.data.order);

/** Where a group short of two frames borrows the rest. Deliberately here and not in
 *  `offer.ts`: these are the same photographs the category pages show under their lists, so
 *  this is a presentation choice, and keeping it here spares every page that imports the
 *  menu from pulling the image imports in with it. Only `Bratki` needs it today - one entry,
 *  four strip frames. */
const stripFallback: Partial<Record<PlantGroup, GalleryPhoto[]>> = {
  Bratki: pansyStrip,
  Chryzantemy: chrysanthemumStrip,
};

const tiles = offer
  .map((page) => {
    const members = plants.filter((plant) => page.groups.includes(plant.data.group));
    const fromEntries = members
      .filter((plant) => plant.data.image !== undefined)
      .map((plant) => plant.data.image!);
    const fromStrips = page.groups
      .flatMap((group) => stripFallback[group] ?? [])
      .map((photo) => photo.src);

    return {
      ...page,
      names: members.map((plant) => plant.data.name),
      photos: [...fromEntries, ...fromStrips].slice(0, 2),
    };
  })
  // A card for an empty group would lead to a page with a heading and no list.
  .filter((page) => page.names.length > 0);
---

<section class="overview" aria-labelledby="oferta-title">
  <div class="overview__head">
    <h2 class="overview__title" id="oferta-title">Kwiaty w naszej ofercie</h2>
    <p class="overview__lead">
      Przy każdej roślinie piszemy, jak ją uprawiać i w jakich kolorach jest u nas dostępna.
    </p>
  </div>

  <ul class="overview__grid">
    {
      tiles.map((tile) => (
        <li>
          <a class="tile" href={tile.href}>
            {tile.photos.length > 0 && (
              <span class:list={["tile__photos", tile.photos.length === 1 && "tile__photos--one"]}>
                {tile.photos.map((photo) => (
                  <Picture
                    class="tile__photo"
                    src={photo}
                    formats={["avif", "webp"]}
                    fallbackFormat="jpg"
                    widths={[240, 480]}
                    sizes="(min-width: 1200px) 110px, (min-width: 700px) 16vw, 45vw"
                    width={240}
                    height={180}
                    alt=""
                    loading="lazy"
                  />
                ))}
              </span>
            )}
            <h3 class="tile__title">{tile.tileTitle}</h3>
            <p class="tile__names">{tile.names.join(" · ")}</p>
            <p class="tile__more">{plantCount(tile.names.length)}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .overview {
    border-top: 1px solid var(--rule);
    padding: var(--pad-section) var(--edge);
    display: grid;
    gap: 1.75rem;
  }

  .overview__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.9rem;
  }

  .overview__title {
    font-size: var(--text-h2);
  }

  .overview__lead {
    max-width: 42ch;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .overview__grid {
    display: grid;
    gap: 1.4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  /* The whole card is the link, so the target is the card and not a word inside it. */
  .tile {
    height: 100%;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--rule);
    background: var(--paper-dim);
    color: inherit;
    text-decoration: none;
  }
  .tile:hover {
    border-color: var(--green);
    background: var(--paper);
  }

  /* Two columns, fixed - see the note at the top of this file. Both the ratio and the count
     are constants here, which is why the tiles cannot drift out of alignment with each
     other: every strip is the same height because every tile is the same width. */
  .tile__photos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  /* A group that cannot muster two frames spans its one across both columns rather than
     leaving a hole, and takes the ratio that keeps the strip the height it would have had.
     No group is in that state today; a new one would be, on the day it gets its first
     photograph and before it gets its second. */
  .tile__photos--one {
    grid-template-columns: 1fr;
  }
  .tile__photos--one .tile__photo {
    aspect-ratio: 8 / 3;
  }

  .tile__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--rule);
  }
  .tile:hover .tile__photo {
    border-color: var(--green);
  }

  .tile__title {
    font-size: var(--text-h3);
    line-height: 1.1;
  }

  .tile__names {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .tile__more {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-grey);
  }
  .tile:hover .tile__more {
    color: var(--green);
  }
</style>
